---
// src/pages/projects.astro
// オーロラグラデーション＆Glassmorphism（ガラスモーフィズム）極限強化版

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

const PROJECTS = [
  {
    id: "hatenaki",
    logo: "/p_logo/hatenaki.png",
    titleJa: "果てなき復興プロジェクト",
    titleEn: "Endless Reconstruction Project",
    descJa: "能登の復興に向けて、一時的な支援で終わらせず「果てなき」持続可能なサポートの仕組みを学生たちの手で創り出していくプロジェクトです。",
    descEn: "A student-led initiative toward Noto’s recovery, going beyond temporary assistance to create sustainable support mechanisms.",
    badgeJa: "復興支援・持続可能",
    badgeEn: "Reconstruction Support",
  },
  {
    id: "mamoneru",
    logo: "/p_logo/mamoneru.png",
    titleJa: "Mamoneruプロジェクト",
    titleEn: "Mamoneru Project",
    descJa: "避難所のQOL向上と災害関連死の撲滅を目指し、全国の中高生が自治体の「段ボールベッド協定」の締結状況を調査・提言していく、社会のセーフティネットを強固にする挑戦です。",
    descEn: "Aiming to improve shelter QOL and eliminate disaster-related deaths, students nationwide investigate and advocate local government 'Cardboard Bed Agreements'.",
    badgeJa: "避難所QOL向上",
    badgeEn: "Shelter QOL Improvement",
  },
  {
    id: "mamomizu",
    logo: "/p_logo/Mamomizu.jpg",
    titleJa: "Mamomizuプロジェクト",
    titleEn: "Mamomizu Project",
    descJa: "災害時に最も深刻な課題となる「水」のインフラや備蓄に焦点を当て、大切な命と生活のインフラを守るための調査や啓発活動を行います。",
    descEn: "Focusing on 'water' infrastructure and stockpiling—the most critical disaster issue—we conduct research and educational campaigns to protect vital life infrastructure.",
    badgeJa: "水インフラ・防災",
    badgeEn: "Water Infrastructure",
  },
  {
    id: "umaimon",
    logo: "/p_logo/umaimon.png",
    titleJa: "能登うまいもん再発見プロジェクト",
    titleEn: "Noto Umaimon Rediscovery Project",
    descJa: "「“能登”を通して人が繋がり、能登を輝かせられる復興支援」を、郷土料理や地元の食材の手配・イベント企画を通して1からメンバー全員で形にしていきます。",
    descEn: "Building recovery support through local cuisine, ingredients, and event planning to connect people and shine a light on Noto from scratch.",
    badgeJa: "食文化・地域貢献",
    badgeEn: "Local Cuisine & Culture",
  },
  {
    id: "survival",
    logo: "/p_logo/survival.jpg",
    titleJa: "survival Academyプロジェクト",
    titleEn: "Survival Academy Project",
    descJa: "いざという時に「生き残る知恵と技術」を学び、身につけるためのアカデミー。中高生世代のリアルな防災力とサバイバルスキルを向上させるためのワークショップや情報発信を行います。",
    descEn: "An academy to learn wisdom and techniques for survival in emergencies. We conduct workshops and information sharing to enhance practical disaster response for youth.",
    badgeJa: "サバイバル・教育",
    badgeEn: "Survival & Education",
  },
  {
    id: "bifrost",
    logo: "/bifrost.jpg",
    titleJa: "NSF Bifröst",
    titleEn: "NSF Bifröst",
    descJa: "能登の記憶と文化をメタバースに架ける「虹の橋」。クラスター（cluster）空間を活用し、飯田高校芸術部の写真ギャラリーやデジタル交流館を展開、世界と能登をオンラインで繋ぎます。",
    descEn: "A 'rainbow bridge' connecting Noto’s memories and culture to the metaverse via cluster, featuring photo galleries by Iida High School Art Club and digital community centers.",
    badgeJa: "メタバース・文化継承",
    badgeEn: "Metaverse & Culture",
  },
  {
    id: "kumamotoumakamon",
    logo: "/p_logo/KumamotoUmakamonPLogo.JPG",
    titleJa: "熊本うまかもんプロジェクト",
    titleEn: "Kumamoto Umakamon Project",
    descJa: "観光や熊本県産の食材の購買など、消費活動を促進することで、食を通じて熊本の経済を支える復興支援プロジェクト。SNSでの郷土料理・食材・店舗の発信と、日本各地でのイベント開催を通じて、熊本の食の魅力を全国へ直接届けます。",
    descEn: "A project supporting Kumamoto’s economy through food consumption, tourism, and purchasing local goods. Sharing culinary appeal via social media and holding events nationwide.",
    badgeJa: "経済支援・地域食",
    badgeEn: "Economic Support",
  },
];
---

<Layout 
  title={currentLang === 'en' ? "PROJECTs List | NSF PROJECTs" : "PROJECTs - プロジェクト一覧 | NSF PROJECTs"} 
  activeKey="projects"
>
  <!-- 背景オーロラグロー＆強力グラデーション -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-blue-50/50 to-indigo-50/30 py-16 md:py-24">
    <!-- 光彩アクセント1 (左上) -->
    <div class="absolute -top-32 -left-20 w-[650px] h-[650px] bg-gradient-to-br from-blue-500/25 via-cyan-400/20 to-transparent rounded-full blur-[150px] pointer-events-none"></div>
    <!-- 光彩アクセント2 (中央右) -->
    <div class="absolute top-1/2 -right-24 w-[700px] h-[700px] bg-gradient-to-bl from-indigo-500/20 via-purple-400/20 to-pink-300/15 rounded-full blur-[160px] pointer-events-none"></div>
    <!-- 光彩アクセント3 (最下部) -->
    <div class="absolute -bottom-32 left-1/4 w-[550px] h-[550px] bg-gradient-to-tr from-blue-600/20 to-teal-400/20 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-14">
      
      <!-- ヘッダータイトル -->
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-blue-500/10 to-indigo-500/10 border border-blue-300/40 text-blue-600 text-xs font-black tracking-widest uppercase backdrop-blur-md shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>OUR INITIATIVES</span>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-900">
            {currentLang === 'en' ? 'Our Projects' : 'プロジェクト一覧'}
          </span>
        </h1>

        <div class="w-20 h-1.5 bg-gradient-to-r from-blue-600 via-indigo-500 to-purple-500 mx-auto rounded-full shadow-xs"></div>

        <p class="text-xs sm:text-sm text-slate-600 font-semibold leading-relaxed">
          {currentLang === 'en' 
            ? 'Explore our student-led initiatives tackling disaster recovery and social challenges.' 
            : '復興支援から防災教育、地域活性化まで、全国の学生が主体となって推進するプロジェクトをご紹介します。'}
        </p>
      </div>

      <!-- プロジェクトカード一覧 (ガラスモーフィズム & レスポンシブ) -->
      <div class="space-y-8">
        {PROJECTS.map((project) => (
          <div class="group bg-white/70 backdrop-blur-2xl rounded-3xl p-6 sm:p-8 border border-white/80 shadow-[0_15px_35px_rgba(0,0,0,0.03)] hover:shadow-[0_25px_50px_rgba(37,99,235,0.12)] hover:border-blue-300/80 transition-all duration-300 w-full overflow-hidden hover:-translate-y-1">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center">
              
              <!-- 左側：ロゴ・サムネイル画像 -->
              <div class="md:col-span-4 lg:col-span-3 w-full">
                <div class="relative w-full aspect-square max-w-[240px] md:max-w-none mx-auto rounded-2xl overflow-hidden bg-white/90 border border-slate-200/60 flex items-center justify-center p-4 shadow-sm group-hover:scale-[1.03] transition-transform duration-300">
                  <img 
                    src={project.logo} 
                    alt={currentLang === 'en' ? project.titleEn : project.titleJa} 
                    class="w-full h-full object-contain rounded-xl"
                  />
                </div>
              </div>

              <!-- 右側：コンテンツ詳細 -->
              <div class="md:col-span-8 lg:col-span-9 space-y-4 text-center md:text-left flex flex-col justify-between h-full">
                <div class="space-y-3">
                  <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                    <span class="text-[10px] font-black uppercase text-blue-600 bg-blue-50/80 border border-blue-200/60 px-3 py-1 rounded-md backdrop-blur-xs">
                      {currentLang === 'en' ? project.badgeEn : project.badgeJa}
                    </span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-black text-slate-900 group-hover:text-blue-600 transition-colors break-words leading-tight">
                    {currentLang === 'en' ? project.titleEn : project.titleJa}
                  </h2>

                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium break-words">
                    {currentLang === 'en' ? project.descEn : project.descJa}
                  </p>
                </div>

                <!-- 詳細を見るボタン -->
                <div class="pt-2 flex justify-center md:justify-start">
                  <a 
                    href={`/${project.id}?lang=${currentLang}`} 
                    class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-black text-xs sm:text-sm px-7 py-3.5 rounded-xl shadow-md shadow-blue-500/20 transition-all duration-300 hover:gap-3 active:scale-95 border border-white/20"
                  >
                    <span>{currentLang === 'en' ? 'View Details' : '詳細を見る'}</span>
                    <span class="text-xs">➔</span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>
