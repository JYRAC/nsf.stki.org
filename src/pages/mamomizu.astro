---
// src/pages/mamomizu.astro
// オーロラグラデーション＆Glassmorphism強化版 Mamomizuプロジェクト詳細ページ

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout 
  title={currentLang === 'en' ? "Mamomizu Project | NSF PROJECTs" : "Mamomizuプロジェクト | NSF PROJECTs"} 
  activeKey="projects"
>
  <!-- 背景オーロラグロー＆強力グラデーション -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-sky-50/40 to-blue-50/30 py-12 md:py-20">
    <!-- 光彩アクセント1 (左上) -->
    <div class="absolute -top-32 -left-20 w-[600px] h-[600px] bg-gradient-to-br from-sky-400/25 via-cyan-300/20 to-transparent rounded-full blur-[150px] pointer-events-none"></div>
    <!-- 光彩アクセント2 (中央右) -->
    <div class="absolute top-1/3 -right-24 w-[650px] h-[650px] bg-gradient-to-bl from-blue-500/20 via-teal-300/15 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">
      
      <!-- タイトルヘッダー -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-500/10 to-cyan-500/10 border border-sky-300/40 text-sky-600 text-xs font-black tracking-widest uppercase backdrop-blur-md shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-500 animate-pulse"></span>
          <span>WATER ENVIRONMENT & DISASTER PREVENTION</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-sky-950 to-blue-900">
            Mamomizuプロジェクト
          </span>
        </h1>

        <div class="w-20 h-1.5 bg-gradient-to-r from-sky-500 via-cyan-400 to-blue-600 mx-auto rounded-full shadow-xs"></div>
      </div>

      <!-- コンセプトカード -->
      <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
        <p class="text-slate-700 text-sm md:text-base leading-relaxed font-medium italic border-l-4 border-sky-500 pl-4 sm:pl-6 py-1 break-words">
          {currentLang === 'en' ? (
            <>
              During disasters, the "72 hours of water" is said to determine life or death, making drinking, cooking, and hygiene urgent challenges.<br><br>
              At the same time, Japan imports vast amounts of "virtual water" through food and products, relying heavily on water environments even in normal times. At Mamomizu, we advance water environment improvements in disasters and solutions to water issues in ordinary times through the two pillars of "proposals" and "action," aiming for an environment where everyone can use water safely.
            </>
          ) : (
            <>
              災害時には「水の72時間」が生死を分けるとされ、飲料・調理・衛生の確保は喫緊の課題です。<br><br>
              同時に、日本は食料や製品を通じて海外から大量の「仮想水（バーチャルウォーター）」を輸入しており、平常時から水環境に大きく依存しています。私達Mamomizuは、災害時の水環境改善と平常時の水問題への取り組みを「提言」と「行動」の両輪で進め、誰もが安心して水使える環境を目指します。
            </>
          )}
        </p>
      </div>

      <!-- 概要 & ミッション (12カラムグリッド) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- 左側：サイドバー（概要・ミッション） -->
        <div class="lg:col-span-4 space-y-6">
          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800/80 shadow-lg space-y-6 relative overflow-hidden">
            <div class="w-full flex justify-center bg-white p-4 rounded-2xl border border-white/20 shadow-xs">
              <img src="/p_logo/Mamomizu.jpg" alt="Mamomizu ロゴ" class="w-full h-auto max-h-36 object-contain rounded-xl">
            </div>

            <div class="space-y-4">
              <h3 class="font-black text-xs text-sky-400 uppercase tracking-widest border-b border-slate-800 pb-2">
                Project Overview
              </h3>
              
              <div class="space-y-3">
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Project Leader' : 'プロジェクトリーダー'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'Junnosuke Kubo' : '久保 惇之介'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Start Date' : '開始時期'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'September 2025' : '2025年9月'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Members' : '現在の参加人数'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? '9 Members' : '計 9 名'}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-sky-900 via-cyan-950 to-slate-950 text-white p-6 sm:p-8 rounded-3xl shadow-md border border-white/10 space-y-3">
            <span class="text-[10px] font-black uppercase text-sky-300 bg-sky-500/20 px-2.5 py-1 rounded-md border border-sky-400/30">
              Our Mission
            </span>
            <p class="text-xs sm:text-sm text-sky-100 leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Through workshops like "What if the water stops?" and the "Youth Water Proposal 2025," high school students convey messages to society while spreading practical actions such as checking stockpiles, water conservation, and social media outreach at home and school. By combining proposals and action, we protect water safety in both emergencies and daily life.' 
                : '高校生が「もし断水したら？」というワークや「ユース水提言2025」を通じて社会に発信し、同時に家庭や学校での備蓄確認・節水行動・SNS発信といった実践を広げていきます。提言と行動を両輪とすることで、災害時も平常時も水の安心を守ります。'}
            </p>
          </div>
        </div>

        <!-- 右側：具体的な活動内容（フェーズ分け） -->
        <div class="lg:col-span-8 bg-white/80 backdrop-blur-xl p-6 sm:p-8 md:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] flex flex-col justify-between space-y-8">
          <div class="space-y-6">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <span class="w-2.5 h-6 bg-gradient-to-b from-sky-500 to-cyan-500 rounded-full shrink-0"></span>
              <h3 class="text-xl font-black text-slate-900 break-words">
                {currentLang === 'en' ? 'Activities & Initiatives' : '具体的な活動内容'}
              </h3>
            </div>
            
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'While incorporating mechanisms to realize the weight of water resources, our activities are divided into two phases: "Disaster Times" and "Ordinary Times."' 
                : '水資源の重みを実感できる仕組みを取り入れながら、活動を「災害時」と「平常時」の2つのフェーズに分けて展開しています。'}
            </p>

            <div class="space-y-4">
              <!-- Phase 1 -->
              <div class="bg-gradient-to-r from-sky-50/80 to-cyan-50/50 p-5 sm:p-6 rounded-2xl border border-sky-100/80 space-y-2">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="bg-sky-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                    {currentLang === 'en' ? 'Phase 1' : 'フェーズ1'}
                  </span>
                  <h4 class="font-black text-slate-900 text-base break-words">
                    {currentLang === 'en' ? 'Improving Water Environments in Disasters' : '災害時の水環境改善'}
                  </h4>
                </div>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words pt-1">
                  {currentLang === 'en' 
                    ? 'Conducting hands-on events assuming water outages. In addition, as an evolution of the Mamoneru project, we develop activities related to T (Toilet) and K (Kitchen) sanitation.' 
                    : '断水を想定した体験型イベントを実施します。また、Mamoneruプロジェクトの発展形として、T（トイレ）・K（キッチン）整備に関する活動を展開します。'}
                </p>
              </div>

              <!-- Phase 2 -->
              <div class="bg-gradient-to-r from-cyan-50/80 to-teal-50/50 p-5 sm:p-6 rounded-2xl border border-cyan-100/80 space-y-2">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="bg-cyan-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                    {currentLang === 'en' ? 'Phase 2' : 'フェーズ2'}
                  </span>
                  <h4 class="font-black text-slate-900 text-base break-words">
                    {currentLang === 'en' ? 'Tackling Water Issues in Ordinary Times' : '平常時からの水問題への取り組み'}
                  </h4>
                </div>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words pt-1">
                  {currentLang === 'en' 
                    ? 'Promoting awareness and inquiry projects on virtual water while studying recycled water and circular utilization systems, exploring implementation in daily life and local communities.' 
                    : 'バーチャルウォーターに関する啓発・探究プロジェクトを進めるとともに、再生水や循環型利用の仕組みを学び、生活や地域社会での実装を探ります。'}
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 数字で実感する「水の重み」 -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <h3 class="text-xl sm:text-2xl font-black text-slate-900">
            {currentLang === 'en' ? 'Realizing the "Weight of Water" in Numbers' : '数字で実感する「水の重み」'}
          </h3>
          <div class="w-12 h-1 bg-gradient-to-r from-sky-500 to-cyan-400 mx-auto rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-md text-center space-y-2">
            <p class="text-3xl sm:text-4xl font-black text-sky-400 leading-tight">
              72<span class="text-base font-bold ml-1">{currentLang === 'en' ? 'Hours' : '時間'}</span>
            </p>
            <p class="text-xs text-slate-300 font-semibold leading-relaxed">
              {currentLang === 'en' ? 'The "72 hours of water" crucial for survival in disasters' : '災害時、生死を分けるとされる「水の72時間」'}
            </p>
          </div>

          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-md text-center space-y-2">
            <p class="text-3xl sm:text-4xl font-black text-cyan-400 leading-tight">
              ~20,000<span class="text-base font-bold ml-1">L</span>
            </p>
            <p class="text-xs text-slate-300 font-semibold leading-relaxed">
              {currentLang === 'en' ? 'Amount of virtual water required to produce 1kg of beef' : '牛肉1kgの生産に必要な仮想水の量'}
            </p>
          </div>

          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-md text-center space-y-2">
            <p class="text-3xl sm:text-4xl font-black text-blue-400 leading-tight">
              12<span class="text-base font-bold ml-1">L</span>
            </p>
            <p class="text-xs text-slate-300 font-semibold leading-relaxed">
              {currentLang === 'en' ? 'Amount of water used in a 1-minute shower' : 'シャワー1分間に使う水の量'}
            </p>
          </div>
        </div>
      </div>

      <!-- T・K整備の重点アクション -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <h3 class="text-xl sm:text-2xl font-black text-slate-900">
            {currentLang === 'en' ? 'Phase 1 | Key Actions for T & K Sanitation' : 'フェーズ1 ｜ T・K整備の重点アクション'}
          </h3>
          <div class="w-12 h-1 bg-gradient-to-r from-sky-500 to-cyan-400 mx-auto rounded-full"></div>
          <p class="text-slate-600 text-xs sm:text-sm font-medium max-w-2xl mx-auto leading-relaxed pt-1">
            {currentLang === 'en' 
              ? 'As an evolution of the Mamoneru project, we develop activities related to T (Toilet) and K (Kitchen) sanitation.' 
              : 'Mamoneruプロジェクトの発展形として、T（トイレ）・K（キッチン）整備に関する活動を展開します。'}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
          
          <!-- T（トイレ） -->
          <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center gap-3 border-b border-slate-100 pb-3">
                <span class="w-2.5 h-6 bg-sky-500 rounded-full shrink-0"></span>
                <h3 class="text-lg font-black text-slate-900 break-words">
                  {currentLang === 'en' ? 'T (Toilet) Sanitation Activities' : 'T（トイレ）整備活動'}
                </h3>
              </div>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium">
                {currentLang === 'en' 
                  ? 'Flush toilets cannot be used in evacuation centers during disasters, and deteriorating hygiene leads to secondary disasters. Therefore, we undertake the following actions:' 
                  : '災害時の避難所では水洗トイレが使用できず、衛生環境の悪化が二次災害につながります。そのため、次のアクションを展開します。'}
              </p>

              <div class="space-y-3">
                <div class="bg-gradient-to-r from-sky-50/80 to-blue-50/50 p-4 rounded-2xl border border-sky-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-sky-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Stockpiling' : '普及・備蓄'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Promoting Portable Toilet Stockpiling' : '簡易トイレの普及・備蓄促進'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Collaborating with municipalities and schools to host exhibitions and workshops using cardboard and coagulant toilets. Calculating required amounts based on "5 uses per person/day for 3 days" to create stockpile plans.' 
                      : '自治体や学校と連携し、段ボールや凝固剤を用いた簡易トイレの実物展示・体験会を実施。「1人1日5回×3日」で必要数を計算し、家庭や学校単位での備蓄計画を作成します。'}
                  </p>
                </div>

                <div class="bg-gradient-to-r from-cyan-50/80 to-sky-50/50 p-4 rounded-2xl border border-cyan-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-cyan-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Hygiene' : '衛生管理'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Hygiene Management Awareness' : '衛生管理の啓発'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Creating "Toilet Hygiene Checklists" and verifying disinfection/handwashing routines. Disseminating proper disposal methods via posters and social media to prevent infectious disease spread.' 
                      : '消毒・手洗い方法の確認や「トイレ衛生チェックシート」を作成。感染症拡大防止のための正しい処理方法を、ポスターやSNSで発信します。'}
                  </p>
                </div>

                <div class="bg-gradient-to-r from-blue-50/80 to-indigo-50/50 p-4 rounded-2xl border border-blue-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-blue-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Proposal' : 'ユース提言'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Policy-Linked Proposals' : '政策に結びつく提言'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Considering policy proposals such as "Mandatory numerical targets for toilet stockpiling."' 
                      : '「トイレ備蓄の数値化義務づけ」など、政策に結びつく提言を検討します。'}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- K（キッチン） -->
          <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center gap-3 border-b border-slate-100 pb-3">
                <span class="w-2.5 h-6 bg-cyan-500 rounded-full shrink-0"></span>
                <h3 class="text-lg font-black text-slate-900 break-words">
                  {currentLang === 'en' ? 'K (Kitchen) Sanitation Activities' : 'K（キッチン）整備活動'}
                </h3>
              </div>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium">
                {currentLang === 'en' 
                  ? 'Cooking becomes difficult during power/water outages, raising nutritional deficits and hygiene risks. We tackle this under the theme of "Securing Food in Disasters."' 
                  : '断水・停電下では調理が困難になり、栄養不足や衛生リスクが高まります。「災害時の食の確保」をテーマに取り組みます。'}
              </p>

              <div class="space-y-3">
                <div class="bg-gradient-to-r from-sky-50/80 to-cyan-50/50 p-4 rounded-2xl border border-sky-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-sky-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Workshop' : '体験イベント'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Emergency Food Cooking Events' : '非常食活用イベント'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Hosting "warm meal experience" workshops using plastic bag cooking and portable stoves beyond alpha rice and hardtack. Conducting cooking workshops under the condition of "What if there is no power or water for 3 days?"' 
                      : 'アルファ米・乾パンだけでなく、ポリ袋調理やカセットコンロを使った「温かい食事体験」イベントを開催。「もし3日間電気も水もなかったら？」という条件での調理ワークショップを行います。'}
                  </p>
                </div>

                <div class="bg-gradient-to-r from-cyan-50/80 to-teal-50/50 p-4 rounded-2xl border border-cyan-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-cyan-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Stockpiling' : '備蓄推進'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Promoting Rolling Stock' : '備蓄とローリングストック推進'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Creating "Food Stockpile Checklists" for homes and schools. Youth propose nutritionally balanced rolling stock menus and share them on social media.' 
                      : '家庭や学校での「食料備蓄チェックリスト」を作成し、実際に確認する活動を実施。栄養バランスを考えたローリングストックメニューをユースが発案し、SNSで発信します。'}
                  </p>
                </div>

                <div class="bg-gradient-to-r from-blue-50/80 to-sky-50/50 p-4 rounded-2xl border border-blue-100/80 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="bg-blue-600 text-white font-black text-[10px] px-2 py-0.5 rounded-md">
                      {currentLang === 'en' ? 'Proposal' : 'ユース提言'}
                    </span>
                    <h4 class="font-black text-slate-900 text-sm">
                      {currentLang === 'en' ? 'Policy-Linked Proposals' : '政策に結びつく提言'}
                    </h4>
                  </div>
                  <p class="text-slate-600 text-xs leading-relaxed font-medium pt-1">
                    {currentLang === 'en' 
                      ? 'Formulating policy proposals such as "Transforming school cafeterias into disaster bases" and "Introducing shared kitchens in evacuation centers."' 
                      : '「学校給食室の防災拠点化」「避難所への共同キッチン導入」などを、政策提言としてまとめます。'}
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- 今後の活動予定 -->
      <div class="bg-white/80 backdrop-blur-xl p-8 sm:p-10 rounded-3xl border border-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.02)] text-center space-y-4 max-w-4xl mx-auto">
        <div class="space-y-2">
          <h3 class="text-xl font-black text-slate-900">
            {currentLang === 'en' ? 'Upcoming Schedule' : '今後の活動予定'}
          </h3>
          <div class="w-12 h-1 bg-gradient-to-r from-sky-500 to-cyan-400 mx-auto rounded-full"></div>
        </div>

