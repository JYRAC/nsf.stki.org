---
// src/pages/bifrost.astro
// オーロラグラデーション＆Glassmorphism強化版 Bifröstプロジェクト詳細ページ

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout 
  title={currentLang === 'en' ? "NSF Bifröst | NSF PROJECTs" : "NSF Bifröst | NSF PROJECTs"} 
  activeKey="projects"
>
  <!-- 背景オーロラグロー＆強力グラデーション -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-purple-50/30 to-blue-50/40 py-12 md:py-20">
    <!-- 光彩アクセント1 (左上) -->
    <div class="absolute -top-32 -left-20 w-[600px] h-[600px] bg-gradient-to-br from-purple-500/20 via-indigo-400/15 to-transparent rounded-full blur-[150px] pointer-events-none"></div>
    <!-- 光彩アクセント2 (中央右) -->
    <div class="absolute top-1/3 -right-24 w-[650px] h-[650px] bg-gradient-to-bl from-blue-400/20 via-pink-300/15 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">
      
      <!-- タイトルヘッダー -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-purple-500/10 to-indigo-500/10 border border-purple-300/40 text-purple-600 text-xs font-black tracking-widest uppercase backdrop-blur-md shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-600 animate-pulse"></span>
          <span>METAVERSE & CULTURE</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-purple-950 to-indigo-900">
            NSF Bifröst
          </span>
        </h1>

        <div class="w-20 h-1.5 bg-gradient-to-r from-purple-600 via-indigo-500 to-blue-500 mx-auto rounded-full shadow-xs"></div>
      </div>

      <!-- コンセプトカード -->
      <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
        <p class="text-slate-700 text-sm md:text-base leading-relaxed font-medium italic border-l-4 border-purple-500 pl-4 sm:pl-6 py-1 break-words">
          {currentLang === 'en' ? (
            <>
              A "rainbow bridge (Bifröst)" built by youth, connecting Noto’s memories and culture to the metaverse.<br class="hidden md:block">
              Photos, narratives, and fragments of landscapes emerge in the digital sky, weaving a story for the future.<br class="hidden md:block">
              This is an endeavor to pass on local traditions as resources for the next era and share them with the world.
            </>
          ) : (
            <>
              能登の記憶と文化をメタバースに架ける、若者たちの「虹の橋（Bifröst）」。<br class="hidden md:block">
              写真や語り、風景の欠片が、デジタルの空に浮かびあがり、未来とつながる物語になる。<br class="hidden md:block">
              それは、地域に息づく営みを次の時代の資源として活かし、世界へ届けるための試みである。
            </>
          )}
        </p>
      </div>

      <!-- グリッドセクション（概要サイドバー + メイン活動内容） -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- サイドバー（概要・プラットフォーム） -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- プロジェクト概要カード -->
          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800/80 shadow-lg space-y-6 relative overflow-hidden">
            <div class="w-full flex justify-center bg-white p-4 rounded-2xl border border-white/20 shadow-xs">
              <img src="/bifrost.jpg" alt="NSF Bifröst ロゴ" class="w-full h-auto max-h-36 object-contain rounded-xl">
            </div>

            <div class="space-y-4">
              <h3 class="font-black text-xs text-purple-400 uppercase tracking-widest border-b border-slate-800 pb-2">
                Project Overview
              </h3>
              
              <div class="space-y-3">
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Project Leader' : 'プロジェクトリーダー'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'Junnosuke Kubo' : '久保 惇之介'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Start Date' : '開始時期'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'March 2025' : '2025年3月'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Members' : '現在の参加人数'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? '5 Members' : '計 5 名'}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- プラットフォーム概要 -->
          <div class="bg-gradient-to-br from-purple-900 via-indigo-900 to-slate-900 text-white p-6 sm:p-8 rounded-3xl shadow-md border border-white/10 space-y-3">
            <span class="text-[10px] font-black uppercase text-purple-300 bg-purple-500/20 px-2.5 py-1 rounded-md border border-purple-400/30">
              Platform
            </span>
            <h4 class="font-black text-base text-white">cluster（クラスター）</h4>
            <p class="text-xs text-purple-100 leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Creating a dedicated virtual space on "cluster", one of Japan’s leading metaverse platforms. Accessible from smartphones, PCs, or VR devices anytime from anywhere in the world.' 
                : '国内大手のメタバースプラットフォーム「cluster」上に特設空間を創造。スマホやPC、VR機器からいつでも世界中からアクセスが可能です。'}
            </p>
          </div>

        </div>

        <!-- メインコンテンツ（具体的な活動内容） -->
        <div class="lg:col-span-8 bg-white/80 backdrop-blur-xl p-6 sm:p-8 md:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] flex flex-col justify-between space-y-8">
          
          <div class="space-y-6">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <span class="w-2.5 h-6 bg-gradient-to-b from-purple-600 to-indigo-600 rounded-full shrink-0"></span>
              <h3 class="text-xl font-black text-slate-900 break-words">
                {currentLang === 'en' ? 'Activities & Initiatives' : '具体的な活動内容'}
              </h3>
            </div>
            
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'We plan and offer content that conveys the charm of Noto through all five senses in a virtual space (metaverse) built using cutting-edge technology by the Rikkyo Ikebukuro High School Math & Science Club.' 
                : '立教池袋高校数理研究部が最先端の技術を用いて作成した仮想空間（メタバース）上に、能登の魅力が五感で伝わるコンテンツを企画・提供しています。'}
            </p>

            <!-- 第一弾企画 -->
            <div class="bg-gradient-to-r from-purple-50/80 to-indigo-50/50 p-5 sm:p-6 rounded-2xl border border-purple-100/80 space-y-2">
              <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                <span class="bg-purple-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                  {currentLang === 'en' ? '1st Project' : '第一弾企画'}
                </span>
                <h4 class="font-black text-slate-900 text-base break-words">
                  {currentLang === 'en' ? 'Iida High School Art Club Photo Gallery' : '飯田高校 芸術部 写真ギャラリー'}
                </h4>
              </div>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words pt-1">
                {currentLang === 'en' 
                  ? 'We are currently constructing a metaverse gallery displaying photos captured by art club students at Ishikawa Prefectural Iida High School (Suzu City), showcasing the "present" and landscapes of Noto through their unique perspectives.' 
                  : '石川県立飯田高校（珠洲市）芸術部の生徒たちが、独自の感性で切り取った能登の「今」や風景の写真を展示する、メタバース特設ギャラリーを現在制作しています。'}
              </p>
            </div>

            <!-- 空間拡張 -->
            <div class="bg-gradient-to-r from-blue-50/80 to-cyan-50/50 p-5 sm:p-6 rounded-2xl border border-blue-100/80 space-y-2">
              <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                <span class="bg-blue-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                  {currentLang === 'en' ? 'Expansion' : '空間拡張'}
                </span>
                <h4 class="font-black text-slate-900 text-base break-words">
                  {currentLang === 'en' ? 'Digital Community Center Opening' : 'デジタル「交流館」のオープン'}
                </h4>
              </div>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words pt-1">
                {currentLang === 'en' 
                  ? 'Beyond just viewing exhibitions, we plan to open an online community hub where people from Noto and visitors globally can interact in real-time via avatars.' 
                  : 'ただ展示を見るだけでなく、能登の人々と全国・世界の人々がアバターを介してリアルタイムで言葉を交わし、温もりで繋がれるオンラインコミュニティ拠点をオープン予定です。'}
              </p>
            </div>
          </div>

          <!-- メタバース入場CTAボタン -->
          <div class="pt-4 border-t border-slate-100 w-full">
            <a 
              href="https://cluster.mu/w/7ada6fd6-acf7-4bc6-829b-859d612e0314" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative w-full inline-flex items-center justify-center px-6 py-4 font-black text-sm sm:text-base text-white transition-all duration-300 bg-gradient-to-r from-purple-600 via-indigo-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 rounded-2xl shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 active:scale-98 text-center border border-white/20"
            >
              <span class="mr-2 break-words">
                {currentLang === 'en' ? 'Enter Bifröst Metaverse (cluster)' : 'Bifröst メタバース空間へ入場する (cluster)'}
              </span>
              <svg class="w-5 h-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>

        </div>

      </div>

      <!-- 今後のスケジュール -->
      <div class="bg-white/80 backdrop-blur-xl p-8 rounded-3xl border border-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.02)] text-center space-y-4">
        <div class="space-y-2">
          <h3 class="text-xl font-black text-slate-900">
            {currentLang === 'en' ? 'Upcoming Schedule' : '今後の活動予定'}
          </h3>
          <div class="w-12 h-1 bg-gradient-to-r from-purple-600 to-indigo-600 mx-auto rounded-full"></div>
        </div>
        <p class="text-purple-600 text-xs sm:text-sm font-black tracking-widest uppercase">
          COMING SOON...
        </p>
      </div>

    </div>
  </section>
</Layout>
