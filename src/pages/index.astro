      <!-- クリスタルキャッチバッジ -->
      <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-xl shadow-[0_0_20px_rgba(255,255,255,0.15)]">
