      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- VISION Card 1 -->
        <div class="crystal-card relative p-8 sm:p-10 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-2xl hover:border-blue-500/50 transition-all duration-500 flex flex-col justify-between group shadow-2xl overflow-hidden">
          <div class="absolute -right-6 -bottom-6 text-9xl font-black text-white/[0.03] select-none pointer-events-none">01</div>
          <div class="space-y-6">
            <div class="h-56 rounded-2xl overflow-hidden relative border border-white/10">
              <img 
                src="/p_logo/sousei.png" 
                alt="能登創生" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700" 
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-black text-white group-hover:text-blue-400 transition">
                {currentLang === 'en' ? 'Noto Revitalization & Project Expansion' : '能登創生とプロジェクト展開'}
              </h3>
              <p class="text-xs md:text-sm text-slate-300 leading-relaxed font-medium">
                {currentLang === 'en'
                  ? "In addition to supporting recovery in Noto, we leverage the unique flexibility and mobility of students to solve diverse societal challenges."
                  : "原点である能登の復興支援はもちろん、学生ならではの柔軟な発想と機動力を活かし、多様な社会課題の解決に向けた取り組みを展開しています。"}
              </p>
            </div>
          </div>
          <div class="mt-8 pt-6 border-t border-white/10">
            <a href="/projects" class="crystal-btn flex items-center justify-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-black text-xs py-4 rounded-xl shadow-lg transition">
              <span>{t.projects}</span>
              <span aria-hidden="true">➔</span>
            </a>
          </div>
        </div>

        <!-- VISION Card 2 -->
        <div class="crystal-card relative p-8 sm:p-10 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-2xl hover:border-amber-500/50 transition-all duration-500 flex flex-col justify-between group shadow-2xl overflow-hidden">
          <div class="absolute -right-6 -bottom-6 text-9xl font-black text-white/[0.03] select-none pointer-events-none">02</div>
          <div class="space-y-6">
            <div class="h-56 rounded-2xl overflow-hidden relative border border-white/10">
              <img 
                src="/unnamed.jpg" 
                alt="集結した学生たち" 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-700" 
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="space-y-3">
              <h3 class="text-2xl font-black text-white group-hover:text-amber-400 transition">
                {currentLang === 'en' ? 'Action by Students Nationwide' : '全国500名超の学生による挑戦'}
              </h3>
              <p class="text-xs md:text-sm text-slate-300 leading-relaxed font-medium">
                {currentLang === 'en'
                  ? "Over 500 members gathered from across Japan. Unbound by existing frameworks, we continuously improve and take steps to open up the future."
                  : "北海道から沖縄県まで、全国から500人を超えるメンバーが集結。行政・企業・地域と連携し、未来を創るアクションを起こします。"}
              </p>
            </div>
          </div>
          <div class="mt-8 pt-6 border-t border-white/10">
            <a href="/about" class="crystal-btn flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-black text-xs py-4 rounded-xl shadow-lg transition">
              <span>{t.about}</span>
              <span aria-hidden="true">➔</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section id="instagram" class="py-24 bg-slate-50 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 space-y-10">
      <div class="text-center">
        <span class="text-xs font-black tracking-widest text-pink-600 uppercase block mb-1">Social Media</span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-900">
          {currentLang === 'en' ? 'Latest Instagram Updates' : '最新のInstagram活動報告'}
        </h2>
      </div>
      
      <div class="rounded-3xl p-4 bg-white border border-slate-200 shadow-sm overflow-hidden">
        <behold-widget feed-id="6GsUr7TV7peuDQ7JbdpG"></behold-widget>
      </div>

      <script>
        (() => {
          const d = document, s = d.createElement("script");
          s.type = "module";
          s.src = "https://w.behold.so/widget.js";
          d.head.append(s);
        })();
      </script>
