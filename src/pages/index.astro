---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getNewsList, type NewsArticle } from "../lib/directus";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

// Directusからお知らせ・活動データの取得
let newsList: NewsArticle[] = [];
try {
  const response = await getNewsList({ limit: 10 });
  newsList = response.contents;
} catch (error) {
  console.error("Directusからのデータ取得に失敗しました:", error);
}

// 緊急お知らせ（is_urgent: true）と通常記事に分割
const urgentNews = newsList.find((item) => item.is_urgent);
const regularNews = newsList.filter((item) => !item.is_urgent);

// カテゴリ判定
function normalizeCategory(rawCategory: any): string {
  if (!rawCategory) return "news";
  if (Array.isArray(rawCategory)) {
    if (rawCategory.length === 0) return "news";
    const first = rawCategory[0];
    return typeof first === "object" && first !== null ? String(first.id || first.name || "news").toLowerCase() : String(first).toLowerCase();
  }
  if (typeof rawCategory === "object" && rawCategory !== null) {
    return String(rawCategory.id || rawCategory.name || "news").toLowerCase();
  }
  return String(rawCategory).toLowerCase();
}

function getCategoryBadge(rawCategory: any) {
  const category = normalizeCategory(rawCategory);
  if (["activity", "活動note", "活動", "note", "活動報告"].includes(category)) {
    return { class: "bg-blue-50 text-blue-700 border-blue-200/80", defaultText: "Note", normalized: "activity" };
  } else if (["event", "イベント"].includes(category)) {
    return { class: "bg-purple-50 text-purple-700 border-purple-200/80", defaultText: "イベント", normalized: "event" };
  } else if (["press", "リリース", "プレスリリース"].includes(category)) {
    return { class: "bg-emerald-50 text-emerald-700 border-emerald-200/80", defaultText: "リリース", normalized: "press" };
  } else if (["recruit", "募集", "採用"].includes(category)) {
    return { class: "bg-rose-50 text-rose-700 border-rose-200/80", defaultText: "募集", normalized: "recruit" };
  } else {
    return { class: "bg-amber-50 text-amber-800 border-amber-200/80", defaultText: "お知らせ", normalized: "news" };
  }
}
---

<Layout title={t.home} activeKey="home" showSplash>

  <!-- 緊急お知らせ -->
  {urgentNews && (
    <div class="relative z-50 bg-gradient-to-r from-red-600 via-rose-600 to-amber-600 text-white py-3 px-4 shadow-xl border-b border-red-700">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs md:text-sm font-medium">
        <div class="flex items-center gap-3 min-w-0">
          <span class="bg-white text-red-700 text-[10px] font-black px-2.5 py-0.5 rounded-full shadow-sm animate-pulse shrink-0">
            {currentLang === 'en' ? 'URGENT' : '緊急情報'}
          </span>
          <span class="font-mono text-white/90 text-xs shrink-0">
            {(urgentNews.published_at ?? urgentNews.date_created).slice(0, 10).replace(/-/g, ".")}
          </span>
          <a 
            href={urgentNews.link || `/news/${urgentNews.id}`} 
            target={urgentNews.link?.startsWith('http') ? '_blank' : '_self'}
            rel={urgentNews.link?.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="font-bold hover:underline truncate"
          >
            {urgentNews.title}
          </a>
        </div>
        <a 
          href={urgentNews.link || `/news/${urgentNews.id}`} 
          target={urgentNews.link?.startsWith('http') ? '_blank' : '_self'}
          rel={urgentNews.link?.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="text-xs font-bold underline shrink-0 hover:text-amber-100 self-end sm:self-auto flex items-center gap-1"
        >
          <span>詳細を見る</span>
          <span aria-hidden="true">➔</span>
        </a>
      </div>
    </div>
  )}

  <!-- ヒーローセクション -->
  <section class="relative min-h-[90vh] flex flex-col justify-center items-center overflow-hidden py-24 px-4 bg-slate-950 text-white">
    <!-- 写真背景：/NSF_.JPG -->
    <img 
      src="/NSF_.JPG" 
      alt="街頭募金活動の様子" 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-30 scale-105 animate-pulse-slow filter brightness-90 contrast-110" 
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-900/60 to-slate-950"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[800px] h-[600px] sm:h-[800px] bg-gradient-to-tr from-blue-600/30 via-indigo-500/20 to-amber-500/20 rounded-full blur-[140px] pointer-events-none animate-aurora"></div>

    <div class="relative z-10 max-w-5xl mx-auto text-center space-y-8">
      
      <!-- 能登半島の復興 × 中高生の防災意識向上 -->
      <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-white/10 border border-white/20 shadow-2xl backdrop-blur-2xl">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-ping"></span>
        <span class="text-xs md:text-sm font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-indigo-200 to-amber-300">
          {currentLang === 'en' ? 'Noto Recovery & Disaster Awareness' : '能登半島の復興 × 中高生の防災意識向上'}
        </span>
      </div>

      <!-- タイトル -->
      <h1 class="text-3xl sm:text-5xl md:text-7xl font-black tracking-tight leading-tight">
        <span class="block text-2xl sm:text-4xl md:text-5xl font-extrabold text-slate-200 mb-3 drop-shadow-md">
          「自然災害」から切り開く
        </span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-400 drop-shadow-lg">
          日本の未来デザイン
        </span>
      </h1>

      <!-- 理念・説明本文 -->
      <p class="text-xs sm:text-base text-slate-300 max-w-3xl mx-auto font-medium leading-relaxed backdrop-blur-2xl p-6 sm:p-8 rounded-3xl bg-white/5 border border-white/10 shadow-2xl">
        {currentLang === 'en' 
          ? "NSF PROJECTs started as a disaster relief initiative for the Noto Peninsula Earthquake and has grown into a student organization with over 500 members nationwide. Driven by the philosophy 'Youth Speak Up, Take Action, and Shape the Future,' we collaborate with local governments, corporations, and communities to take on bold challenges."
          : "NSF PROJECTsは能登半島地震の復興支援を出発点に、現在500名を超えるメンバーで活動する学生団体です。「能登の復興」と「中高生の防災意識向上」を目的に、北海道から沖縄まで全国のメンバーが奮闘中。「若者が声をあげ、行動し、未来を創る」を理念に行政・企業・地域と連携しながら挑戦を続けていきます。"}
      </p>

      <!-- 3つのCTAボタン群 -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 w-full max-w-2xl mx-auto px-2">
        <a 
          href="/about" 
          class="crystal-btn w-full sm:w-auto flex-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-600 text-white font-black text-xs sm:text-sm py-4 px-6 rounded-2xl shadow-[0_0_25px_rgba(37,99,235,0.4)] border border-white/20 transition-all duration-300 text-center flex items-center justify-center whitespace-nowrap min-h-[56px]"
        >
          {t.about}
        </a>

        <a 
          href="/ema" 
          class="crystal-btn w-full sm:w-auto flex-1 bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 hover:from-amber-400 hover:to-orange-500 text-white font-black text-xs sm:text-sm py-4 px-6 rounded-2xl shadow-[0_0_25px_rgba(245,158,11,0.4)] border border-white/20 transition-all duration-300 text-center flex items-center justify-center gap-2 whitespace-nowrap min-h-[56px]"
        >
          <span class="text-base leading-none" aria-hidden="true">⛩️</span>
          <span>{t.emaSubmit}</span>
        </a>

        <a 
          href="/projects" 
          class="crystal-btn w-full sm:w-auto flex-1 bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-xl font-black text-xs sm:text-sm py-4 px-6 rounded-2xl shadow-lg transition-all duration-300 text-center flex items-center justify-center gap-1.5 whitespace-nowrap min-h-[56px]"
        >
          <span>{t.projects}</span>
          <span class="text-xs transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">➔</span>
        </a>
      </div>
    </div>
  </section>

  <!-- お知らせ & 活動Note (グリッドカード配置へ完全刷新) -->
  <section class="relative py-24 bg-slate-50 text-slate-900 overflow-hidden border-t border-b border-slate-200" id="news">
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100/50 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-amber-100/50 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 space-y-12">
      
