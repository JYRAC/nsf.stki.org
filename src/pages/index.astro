---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getNewsList, type NewsArticle } from "../lib/directus";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

// Directusからお知らせ・活動データの取得
let newsList: NewsArticle[] = [];
try {
  const response = await getNewsList({ limit: 10 });
  newsList = response.contents;
} catch (error) {
  console.error("Directusからのデータ取得に失敗しました:", error);
}

// 緊急お知らせ（is_urgent: true）と通常記事に分割
const urgentNews = newsList.find((item) => item.is_urgent);
const regularNews = newsList.filter((item) => !item.is_urgent);

// カテゴリ判定
function normalizeCategory(rawCategory: any): string {
  if (!rawCategory) return "news";
  if (Array.isArray(rawCategory)) {
    if (rawCategory.length === 0) return "news";
    const first = rawCategory[0];
    return typeof first === "object" && first !== null ? String(first.id || first.name || "news").toLowerCase() : String(first).toLowerCase();
  }
  if (typeof rawCategory === "object" && rawCategory !== null) {
    return String(rawCategory.id || rawCategory.name || "news").toLowerCase();
  }
  return String(rawCategory).toLowerCase();
}

function getCategoryBadge(rawCategory: any) {
  const category = normalizeCategory(rawCategory);
  if (["activity", "活動note", "活動", "note", "活動報告"].includes(category)) {
    return { class: "bg-blue-50 text-blue-700 border-blue-200/80", defaultText: "Note", normalized: "activity" };
  } else if (["event", "イベント"].includes(category)) {
    return { class: "bg-purple-50 text-purple-700 border-purple-200/80", defaultText: "イベント", normalized: "event" };
  } else if (["press", "リリース", "プレスリリース"].includes(category)) {
    return { class: "bg-emerald-50 text-emerald-700 border-emerald-200/80", defaultText: "リリース", normalized: "press" };
  } else if (["recruit", "募集", "採用"].includes(category)) {
    return { class: "bg-rose-50 text-rose-700 border-rose-200/80", defaultText: "募集", normalized: "recruit" };
  } else {
    return { class: "bg-amber-50 text-amber-800 border-amber-200/80", defaultText: "お知らせ", normalized: "news" };
  }
}
---

<Layout title={t.home} activeKey="home" showSplash>

  <!-- 緊急お知らせ -->
