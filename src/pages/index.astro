          <a href={urgentNews.link || `/news/${urgentNews.id}`} class="font-bold hover:underline truncate">
            {urgentNews.title}
          </a>
        </div>
        <a href={urgentNews.link || `/news/${urgentNews.id}`} class="text-xs font-bold underline shrink-0 hover:text-amber-100 self-end sm:self-auto">
