---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import NoteCard from "../components/NoteCard.astro";
import { getLatestNoteArticles } from "../lib/notes";
import { getNewsList, type NewsArticle } from "../lib/directus";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

// 1. Note記事の取得
let articles = [];
try {
  articles = await getLatestNoteArticles(3);
} catch (e) {
  console.error("Noteの取得に失敗しました:", e);
}

// 2. Directusからお知らせ・活動データの取得
let newsList: NewsArticle[] = [];
try {
  const response = await getNewsList({ limit: 10 });
  newsList = response.contents;
} catch (error) {
  console.error("Directusからのデータ取得に失敗しました:", error);
}

// 緊急お知らせ（is_urgent: true）と通常記事に分割
const urgentNews = newsList.find((item) => item.is_urgent);
const regularNews = newsList.filter((item) => !item.is_urgent);

// カテゴリ文字列の正規化
function normalizeCategory(rawCategory: any): string {
  if (!rawCategory) return "news";
  if (Array.isArray(rawCategory)) {
    if (rawCategory.length === 0) return "news";
    const first = rawCategory[0];
    return typeof first === "object" && first !== null ? String(first.id || first.name || "news").toLowerCase() : String(first).toLowerCase();
  }
  if (typeof rawCategory === "object" && rawCategory !== null) {
    return String(rawCategory.id || rawCategory.name || "news").toLowerCase();
  }
  return String(rawCategory).toLowerCase();
}

// カテゴリに応じたバッジ色とテキスト
function getCategoryBadge(rawCategory: any) {
  const category = normalizeCategory(rawCategory);
  
  if (["activity", "活動note", "活動", "note", "活動報告"].includes(category)) {
    return { class: "bg-blue-50 text-blue-700 border-blue-200", defaultText: "Note", normalized: "activity" };
  } else if (["event", "イベント"].includes(category)) {
    return { class: "bg-purple-50 text-purple-700 border-purple-200", defaultText: "イベント", normalized: "event" };
  } else if (["press", "リリース", "プレスリリース"].includes(category)) {
    return { class: "bg-emerald-50 text-emerald-700 border-emerald-200", defaultText: "リリース", normalized: "press" };
  } else if (["recruit", "募集", "採用"].includes(category)) {
    return { class: "bg-rose-50 text-rose-700 border-rose-200", defaultText: "募集", normalized: "recruit" };
  } else {
    return { class: "bg-amber-50 text-amber-800 border-amber-200", defaultText: "お知らせ", normalized: "news" };
  }
}
---

<Layout title={t.home} activeKey="home" showSplash>

  <!-- 1. 緊急バナー (ヒーロー上部にスッキリ配置) -->
  {urgentNews && (
    <div class="bg-red-600 text-white border-b border-red-700 py-2.5 px-4 sticky top-0 z-50 shadow-md">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs md:text-sm font-medium">
        <div class="flex items-center gap-2 min-w-0">
          <span class="bg-white text-red-700 text-[10px] font-black px-2 py-0.5 rounded shadow-xs shrink-0">
            {currentLang === 'en' ? 'URGENT' : '緊急情報'}
          </span>
          <span class="font-mono text-red-100 text-xs shrink-0">
            {(urgentNews.published_at ?? urgentNews.date_created).slice(0, 10).replace(/-/g, ".")}
          </span>
          <a href={urgentNews.link || `/news/${urgentNews.id}`} class="font-bold hover:underline truncate">
            {urgentNews.title}
          </a>
        </div>
        <a href={urgentNews.link || `/news/${urgentNews.id}`} class="text-xs font-bold underline shrink-0 hover:text-red-100 self-end sm:self-auto">
          詳細を見る ➔
        </a>
      </div>
    </div>
  )}

  <!-- 2. ヒーローセクション -->
  <section class="relative min-h-[75vh] flex flex-col justify-center items-center bg-slate-950 text-white overflow-hidden py-16 px-4">
    <img src="/NSF_.JPG" alt="街頭募金活動の様子" class="absolute inset-0 w-full h-full object-cover object-center opacity-30 scale-105 transition-transform duration-1000 hover:scale-100" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-900/40"></div>

    <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
      <div class="inline-block px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-400 font-extrabold text-xs md:text-sm tracking-widest backdrop-blur-md">
        {t.heroCatch}
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-6xl font-black tracking-tight leading-tight drop-shadow-md">
        <span>{t.heroTitleLine1}</span><br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-slate-300">{t.heroTitleLine2}</span>
      </h1>

      <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto font-medium leading-relaxed opacity-90">
        {t.heroSub}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4 w-full max-w-md mx-auto">
        <a href="/about" class="btn-hover-effect w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm px-7 py-3.5 rounded-xl shadow-lg transition text-center">
          {t.about}
        </a>
        <a href="/ema" class="btn-hover-effect w-full sm:w-auto bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-white font-bold text-sm px-7 py-3.5 rounded-xl shadow-lg transition text-center">
          {t.emaSubmit}
        </a>
        <a href="/projects" class="btn-hover-effect w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold text-sm px-7 py-3.5 rounded-xl backdrop-blur-sm transition text-center">
          {t.projects} ➔
        </a>
      </div>
    </div>
  </section>

  <!-- 3. お知らせ & 活動Note セクション -->
  <section class="py-16 bg-slate-50/50 border-b border-slate-200" id="news">
    <div class="max-w-4xl mx-auto px-4 space-y-8">

      <!-- ヘッダー & タブナビゲーション -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <span class="text-xs font-black tracking-widest text-blue-600 uppercase">Updates</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">{t.news}</h2>
        </div>

        {/* タブ切り替えボタン (モダンなPillデザイン) */}
        <div class="flex items-center gap-1 bg-slate-200/80 p-1 rounded-xl w-full sm:w-auto">
          <button class="tab-btn active flex-1 sm:flex-none text-xs font-bold px-4 py-2 rounded-lg transition-all bg-white text-slate-900 shadow-xs cursor-pointer" data-tab="all">
            {currentLang === 'en' ? 'All' : 'すべて'}
          </button>
          <button class="tab-btn flex-1 sm:flex-none text-xs font-bold px-4 py-2 rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer" data-tab="news">
            {currentLang === 'en' ? 'News' : 'お知らせ'}
          </button>
          <button class="tab-btn flex-1 sm:flex-none text-xs font-bold px-4 py-2 rounded-lg transition-all text-slate-600 hover:text-slate-900 cursor-pointer" data-tab="activity">
            {currentLang === 'en' ? 'Activity' : '活動Note'}
          </button>
        </div>
      </div>

      <!-- リスト一覧 (見やすいカード行デザイン) -->
      <div class="space-y-3" id="filterableList">
        {regularNews.length > 0 ? (
          regularNews.map((item) => {
            const badge = getCategoryBadge(item.category);
            return (
              <a 
                href={item.link || `/news/${item.id}`}
                target={item.link?.startsWith('http') ? '_blank' : '_self'}
                class="news-item group block p-4 bg-white hover:bg-blue-50/30 rounded-xl border border-slate-200/80 hover:border-blue-300 shadow-xs hover:shadow-md transition-all duration-200 -translate-y-0 hover:-translate-y-0.5" 
                data-category={badge.normalized}
              >
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="text-xs font-mono font-bold text-slate-400 shrink-0">
                      {(item.published_at ?? item.date_created).slice(0, 10).replace(/-/g, ".")}
                    </span>
                    <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border shrink-0 ${badge.class}`}>
                      {item.badge_text || badge.defaultText}
                    </span>
                    <span class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition truncate">
                      {item.title}
                    </span>
                  </div>
                  <span class="text-xs font-bold text-slate-400 group-hover:text-blue-600 shrink-0 hidden sm:inline-block">
                    ➔
                  </span>
                </div>
              </a>
            );
          })
        ) : (
          <div class="text-center py-12 bg-white rounded-xl border border-slate-200">
            <p class="text-xs text-slate-400">現在掲載中のお知らせはありません。</p>
          </div>
        )}
      </div>

      <div class="text-center pt-2">
        <a href="https://note.com" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-blue-600 hover:text-blue-800 inline-flex items-center gap-1.5 transition">
          <span>公式Noteで一覧を見る</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- 4. WHAT WE DO -->
  <section class="py-20 max-w-4xl mx-auto px-4 text-center">
    <span class="text-xs font-black text-blue-600 tracking-widest uppercase block mb-2">WHAT WE DO</span>
    <h2 class="text-2xl md:text-4xl font-black text-slate-900 mb-6 leading-tight">
      {currentLang === 'en' ? (
        <>Moving Beyond Our Name:<br />Our Challenge for the Future</>
      ) : (
        <>名称の由来を超えて<br />私たちが目指す未来への挑戦</>
      )}
    </h2>
    <p class="text-slate-600 text-sm md:text-base leading-relaxed max-w-2xl mx-auto font-medium">
      {currentLang === 'en' 
        ? "NSF PROJECTs is more than just 'Noto Student Fund.' While our roots stem from disaster relief for the Noto Peninsula Earthquake, we have evolved into a project-driven organization where students nationwide actively tackle various social issues."
        : "NSF PROJECTsは「Noto Student Fund」という名称の時点に留まる組織ではありません。能登半島地震をきっかけに始まった活動をすべての原点としつつ、現在は全国の学生が社会課題に対して主体的に挑戦するプロジェクト型組織へと発展を遂げています。"}
    </p>
  </section>

  <!-- ギャラリー画像 -->
  <section class="pb-20 max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="overflow-hidden rounded-2xl border border-slate-200/80 shadow-md aspect-video group">
        <img src="/unnamed.jpg" alt="被災地支援活動の様子1" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
      </div>
      <div class="overflow-hidden rounded-2xl border border-slate-200/80 shadow-md aspect-video group">
        <img src="/unnamed (1).jpg" alt="被災地支援活動の様子2" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
      </div>
    </div>
  </section>

  <!-- 5. VISION -->
  <section class="py-20 bg-slate-900 text-white border-t border-b border-slate-800 w-full">
    <div class="max-w-5xl mx-auto px-4 space-y-12">
      <div class="text-center">
        <span class="text-xs font-black text-blue-400 tracking-widest block mb-2 uppercase">VISION</span>
        <h2 class="text-2xl md:text-4xl font-black">
          {currentLang === 'en' ? 'The Value We Create' : '私たちが生み出す価値'}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-slate-800/60 p-6 md:p-8 rounded-2xl border border-slate-700/60 backdrop-blur-sm flex flex-col justify-between hover:border-slate-600 transition">
          <div>
            <div class="h-48 rounded-xl overflow-hidden mb-6 bg-slate-900">
              <img src="/p_logo/sousei.png" alt="能登の海とメンバー" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-xl font-black mb-3">
              {currentLang === 'en' ? 'Noto Revitalization & Project Expansion' : '能登創生とプロジェクト展開'}
            </h3>
            <p class="text-xs md:text-sm text-slate-300 leading-relaxed font-medium">
              {currentLang === 'en'
                ? "In addition to supporting recovery in Noto, we leverage the unique flexibility and mobility of students to solve diverse societal challenges."
                : "原点である能登の復興支援はもちろん、学生ならではの柔軟な発想と機動力を活かし、多様な社会課題の解決に向けた取り組みを展開しています。"}
            </p>
          </div>
          <div class="mt-8">
            <a href="/projects" class="block text-center bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-3 rounded-xl transition">
              {t.projects} ➔
            </a>
          </div>
        </div>

        <div class="bg-slate-800/60 p-6 md:p-8 rounded-2xl border border-slate-700/60 backdrop-blur-sm flex flex-col justify-between hover:border-slate-600 transition">
          <div>
            <div class="h-48 rounded-xl overflow-hidden mb-6 bg-slate-900">
              <img src="/unnamed.jpg" alt="集結した学生たち" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-xl font-black mb-3">
              {currentLang === 'en' ? 'Action by Students Nationwide' : '全国の学生による挑戦'}
            </h3>
            <p class="text-xs md:text-sm text-slate-300 leading-relaxed font-medium">
              {currentLang === 'en'
                ? "Over 500 members gathered from across Japan. Unbound by existing frameworks, we continuously improve and take steps to open up the future."
                : "全国から500人を超えるメンバーが集結。存在意義の否定や既存の枠組みにとらわれず、絶えず改善を重ねながら未来を切り拓くアクションを起こします。"}
            </p>
          </div>
          <div class="mt-8">
            <a href="/about" class="block text-center bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-3 rounded-xl transition">
              {t.about} ➔
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. NOTE セクション -->
  <section id="note" class="py-20 border-t border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-xs font-black text-blue-600 tracking-widest block mb-1 uppercase">NOTE</span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-900">
          {currentLang === 'en' ? 'Official Note Articles' : '公式Note・活動記事'}
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articles.map((article) => (
          <NoteCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. INSTAGRAM -->
  <section id="instagram" class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-lg font-bold text-slate-900">
          {currentLang === 'en' ? 'Latest Instagram Updates' : '最新のInstagram活動報告'}
        </h2>
      </div>
      <behold-widget feed-id="6GsUr7TV7peuDQ7JbdpG"></behold-widget>
      <script>
        (() => {
          const d = document, s = d.createElement("script");
          s.type = "module";
          s.src = "https://w.behold.so/widget.js";
          d.head.append(s);
        })();
      </script>
    </div>
  </section>
</Layout>

<script>
  function setupNewsTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const newsItems = document.querySelectorAll('.news-item');

    if (!tabButtons.length || !newsItems.length) return;

    tabButtons.forEach(button => {
      const newButton = button.cloneNode(true) as HTMLElement;
      button.parentNode?.replaceChild(newButton, button);

      newButton.addEventListener('click', () => {
        const allButtons = document.querySelectorAll('.tab-btn');
        const allItems = document.querySelectorAll('.news-item');

        // タブボタンのアクティブスタイル切り替え
        allButtons.forEach(btn => {
          btn.classList.remove('bg-white', 'text-slate-900', 'shadow-xs');
          btn.classList.add('text-slate-600');
        });
        newButton.classList.add('bg-white', 'text-slate-900', 'shadow-xs');
        newButton.classList.remove('text-slate-600');

        const selectedTab = newButton.getAttribute('data-tab');

        // 表示の絞り込み
        allItems.forEach(item => {
          const itemCategory = (item.getAttribute('data-category') || 'news').toLowerCase().trim();
          const el = item as HTMLElement;

          if (selectedTab === 'all') {
            el.style.display = 'block';
          } else if (selectedTab === 'activity') {
            el.style.display = itemCategory === 'activity' ? 'block' : 'none';
          } else if (selectedTab === 'news') {
            el.style.display = itemCategory !== 'activity' ? 'block' : 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewsTabs);
  } else {
    setupNewsTabs();
  }
  document.addEventListener('astro:page-load', setupNewsTabs);
</script>

<style>
  .btn-hover-effect {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-hover-effect:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .btn-hover-effect:active {
    transform: translateY(0px);
  }
</style>
