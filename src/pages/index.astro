<script>
  function setupNewsTabs() {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const newsItems = document.querySelectorAll('.news-item');

    if (!tabButtons.length || !newsItems.length) return;

    tabButtons.forEach(button => {
      const newButton = button.cloneNode(true) as HTMLElement;
      button.parentNode?.replaceChild(newButton, button);

      newButton.addEventListener('click', () => {
        const allButtons = document.querySelectorAll('.tab-btn');
        const allItems = document.querySelectorAll('.news-item');

        allButtons.forEach(btn => {
          btn.classList.remove('bg-white', 'text-blue-600', 'shadow-[0_2px_10px_rgba(0,0,0,0.08)]');
          btn.classList.add('text-slate-600');
        });
        newButton.classList.add('bg-white', 'text-blue-600', 'shadow-[0_2px_10px_rgba(0,0,0,0.08)]');
        newButton.classList.remove('text-slate-600');

        const selectedTab = newButton.getAttribute('data-tab');

        allItems.forEach(item => {
          const itemCategory = (item.getAttribute('data-category') || 'news').toLowerCase().trim();
          const el = item as HTMLElement;

          if (selectedTab === 'all') {
            el.style.display = 'block';
          } else if (selectedTab === 'activity') {
            el.style.display = itemCategory === 'activity' ? 'block' : 'none';
          } else if (selectedTab === 'news') {
            el.style.display = itemCategory !== 'activity' ? 'block' : 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewsTabs);
  } else {
    setupNewsTabs();
  }
  document.addEventListener('astro:page-load', setupNewsTabs);
</script>

<style>
  @keyframes aurora {
    0%, 100% {
      transform: translate(-50%, -50%) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(-45%, -55%) rotate(180deg) scale(1.15);
    }
  }

  .animate-aurora {
    animation: aurora 22s infinite linear;
  }

  .animate-pulse-slow {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .crystal-btn {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .crystal-btn:hover {
    transform: translateY(-3px) scale(1.02);
  }
  .crystal-btn:active {
    transform: translateY(0px) scale(0.98);
  }

