          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">{t.news}</h2>
        </div>

        <!-- タブ切り替えボタン -->
        <div class="flex items-center gap-1.5 p-1.5 rounded-2xl bg-slate-200/80 border border-slate-300/60 backdrop-blur-xl w-full sm:w-auto" role="tablist">
          <button class="tab-btn active flex-1 sm:flex-none text-xs font-black px-6 py-3 rounded-xl transition-all duration-300 bg-white text-blue-600 shadow-sm cursor-pointer" data-tab="all" role="tab" aria-selected="true">
            {currentLang === 'en' ? 'All' : 'すべて'}
