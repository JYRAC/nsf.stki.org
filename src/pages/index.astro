                data-category={badge.normalized}
              >
                <div class="space-y-4">
                  <div class="flex items-center justify-between gap-2">
                    <span class={`text-[11px] font-extrabold px-3 py-1 rounded-full border ${badge.class}`}>
                      {item.badge_text || badge.defaultText}
                    </span>
                    <span class="text-xs font-mono font-bold text-slate-400">
                      {(item.published_at ?? item.date_created).slice(0, 10).replace(/-/g, ".")}
                    </span>
                  </div>
                  <h3 class="text-base font-bold text-slate-800 group-hover:text-blue-600 transition leading-snug line-clamp-3">
                    {item.title}
                  </h3>
                </div>

                <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-end text-xs font-bold text-blue-600 group-hover:translate-x-1 transition-transform">
                  <span>記事を読む</span>
                  <span class="ml-1" aria-hidden="true">➔</span>
                </div>
              </a>
