            {currentLang === 'en' ? 'URGENT' : '緊急情報'}
          </span>
          <span class="font-mono text-white/80 text-xs shrink-0">
            {(urgentNews.published_at ?? urgentNews.date_created).slice(0, 10).replace(/-/g, ".")}
          </span>
          <a href={urgentNews.link || `/news/${urgentNews.id}`} class="font-bold hover:underline truncate">
            {urgentNews.title}
          </a>
        </div>
        <a href={urgentNews.link || `/news/${urgentNews.id}`} class="text-xs font-bold underline shrink-0 hover:text-amber-200 self-end sm:self-auto">
          詳細を見る ➔
        </a>
      </div>
    </div>
  )}

  <!-- ヒーローセクション（クリスタル＆オーロラ背景） -->
