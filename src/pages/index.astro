    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-blue-600/20 via-indigo-600/20 to-amber-500/20 rounded-full blur-[160px] pointer-events-none"></div>

