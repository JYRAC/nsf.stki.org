</Layout>

<script>
  function setupNewsTabs() {
    const filterContainer = document.getElementById('news');
    if (!filterContainer) return;

    const tabButtons = filterContainer.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const newsItems = filterContainer.querySelectorAll<HTMLElement>('.news-item');

    if (!tabButtons.length || !newsItems.length) return;

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const selectedTab = button.getAttribute('data-tab');

        // タブスタイル & aria 属性更新
        tabButtons.forEach(btn => {
          const isSelected = btn === button;
          btn.setAttribute('aria-selected', isSelected.toString());
          btn.classList.toggle('bg-white', isSelected);
          btn.classList.toggle('text-blue-600', isSelected);
          btn.classList.toggle('shadow-sm', isSelected);
          btn.classList.toggle('text-slate-600', !isSelected);
        });

        // カードフィルタリング
        newsItems.forEach(item => {
          const itemCategory = (item.getAttribute('data-category') || 'news').toLowerCase().trim();

          if (selectedTab === 'all') {
            item.style.display = 'flex';
          } else if (selectedTab === 'activity') {
            item.style.display = itemCategory === 'activity' ? 'flex' : 'none';
          } else if (selectedTab === 'news') {
            item.style.display = itemCategory !== 'activity' ? 'flex' : 'none';
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewsTabs);
  } else {
    setupNewsTabs();
  }
  document.addEventListener('astro:page-load', setupNewsTabs);
</script>

<style>
  @keyframes aurora {
    0%, 100% {
      transform: translate(-50%, -50%) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(-45%, -55%) rotate(180deg) scale(1.15);
    }
  }

  .animate-aurora {
    animation: aurora 22s infinite linear;
  }

  .animate-pulse-slow {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .crystal-btn {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .crystal-btn:hover {
    transform: translateY(-2px) scale(1.01);
  }
  .crystal-btn:active {
    transform: translateY(0px) scale(0.98);
  }

  .crystal-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
