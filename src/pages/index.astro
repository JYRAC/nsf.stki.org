          <button class="tab-btn flex-1 sm:flex-none text-xs font-black px-6 py-3 rounded-xl transition-all duration-300 text-slate-600 hover:text-slate-900 cursor-pointer" data-tab="activity" role="tab" aria-selected="false">
            {currentLang === 'en' ? 'Activity Note' : '活動Note'}
