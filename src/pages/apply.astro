---
// src/pages/apply.astro
// レイアウト構造を一から刷新した新規設計デザイン

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
---

<Layout title={currentLang === 'en' ? "APPLY - Join Us | NSF PROJECTs" : "APPLY - メンバー募集 | NSF PROJECTs"} activeKey="apply">
  <!-- メインコンテナ -->
  <section class="w-full bg-gradient-to-b from-slate-50 via-white to-blue-50/30 py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-16">
      
      <!-- [1] ヒーローレイアウト：2カラム非対称分割 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white/90 backdrop-blur-md rounded-3xl p-6 sm:p-10 md:p-12 border border-slate-200/80 shadow-sm">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200/80 text-blue-600 text-xs font-black tracking-widest uppercase">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            <span>JOIN OUR TEAM</span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 leading-tight tracking-tight">
            {currentLang === 'en' ? (
              <>
                Starting from the Noto Earthquake,<br class="hidden sm:block">
                Challenge the future with us using your unique talents.
              </>
            ) : (
              <>
                能登の震災を原点に、<br class="hidden sm:block">
                あなたの個性を活かして一緒に未来へ挑みませんか？
              </>
            )}
          </h1>

          <div class="w-16 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full"></div>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-medium">
            {currentLang === 'en'
              ? 'NSF PROJECTs is actively recruiting student members nationwide to tackle disaster prevention and social issues together beyond existing boundaries.'
              : 'NSF PROJECTsでは、枠組みを越えて防災や社会課題に立ち向かう学生メンバーを全国から随時募集しています。あなたの個性を発揮できる場所が、ここには必ずあります。'}
          </p>

          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a 
              href="https://discord.gg/5kQJQ3fDwc" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white font-black text-sm rounded-2xl shadow-md transition-all hover:scale-105 active:scale-95"
            >
              <span>{currentLang === 'en' ? 'Agree & Join Discord' : '同意してDiscordに参加する'}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
            <span class="text-xs text-slate-400 font-medium">※コミュニティ参加無料</span>
          </div>
        </div>

        <div class="lg:col-span-5 relative min-h-[260px] lg:min-h-[320px] rounded-2xl overflow-hidden border border-slate-200">
          <img src="/apply.jpg" alt="NSF PROJECTs 活動イメージ" class="absolute inset-0 w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent flex items-end p-6">
            <p class="text-white text-xs font-bold">全国の学生がオンライン・オフラインで連携中</p>
          </div>
        </div>

      </div>

      <!-- [2] 3つの特徴グリッド -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            {currentLang === 'en' ? 'Why Join NSF PROJECTs?' : 'NSF PROJECTsで活動する理由'}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-medium">全国各地の学生が集い、アイデアを形にする環境があります</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 font-black flex items-center justify-center text-sm">01</div>
            <h3 class="font-black text-slate-900 text-base">{currentLang === 'en' ? 'Nationwide Network' : '全国に広がる仲間'}</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">{currentLang === 'en' ? 'Peers interested in disaster prevention join from all over Japan.' : '全国から防災や社会課題に関心を持つ多くの仲間が参加しています。'}</p>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 font-black flex items-center justify-center text-sm">02</div>
            <h3 class="font-black text-slate-900 text-base">{currentLang === 'en' ? 'Leverage Your Strengths' : '個性を活かす企画'}</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">{currentLang === 'en' ? 'Valuing each member’s ideas, launch new projects freely.' : '一人ひとりの思いや得意分野を尊重し、新しい企画を自由に立ち上げられます。'}</p>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 font-black flex items-center justify-center text-sm">03</div>
            <h3 class="font-black text-slate-900 text-base">{currentLang === 'en' ? 'Collaborate on Discord' : 'Discordでのスムーズな連携'}</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-medium">{currentLang === 'en' ? 'Members collaborate smoothly regardless of region.' : 'オンラインツールを活用し、学年や地域を問わずスムーズにやり取りしています。'}</p>
          </div>
        </div>
      </div>

      <!-- [3] プライバシーポリシーパネル -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs space-y-4">
        <h3 class="font-black text-slate-900 text-base flex items-center gap-2 border-b border-slate-100 pb-3">
          <span class="w-2 h-4 bg-blue-600 rounded-xs"></span>
          <span>{currentLang === 'en' ? 'Privacy Policy' : '個人情報の取扱い（プライバシーポリシー）'}</span>
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed font-medium">
          {currentLang === 'en'
            ? 'NSF PROJECTs properly manages personal information (name, contact info, Discord account) obtained during application in accordance with protection laws.'
            : 'NSF PROJECTsは、メンバー応募時および活動に際して取得した個人情報（氏名、連絡先、Discordアカウント等）について、個人情報保護法に基づき適切に管理いたします。'}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
            <p class="font-bold text-slate-900">1. 利用目的</p>
            <p class="text-slate-600 leading-relaxed">活動に関する連絡、メンバー間の連携、およびプロジェクト運営のみに利用します。</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-1">
            <p class="font-bold text-slate-900">2. 第三者提供の禁止</p>
            <p class="text-slate-600 leading-relaxed">法令に基づく場合を除き、ご本人の同意を得ずに第三者へ情報開示しません。</p>
          </div>
        </div>
      </div>

      <!-- [4] マスコット（えぬくま）フィーチャー -->
      <div class="bg-gradient-to-r from-blue-50 via-white to-indigo-50 rounded-2xl p-6 sm:p-8 border border-blue-100 flex flex-col sm:flex-row items-center gap-6">
        <div class="p-2 bg-white rounded-xl border border-slate-200 shrink-0 shadow-xs">
          <img src="/IMG_1413.jpg" alt="公式マスコット えぬくま" class="w-20 h-20 object-contain rounded-lg">
        </div>
        <div class="text-center sm:text-left space-y-1">
          <span class="text-[10px] font-black uppercase text-blue-600 tracking-wider">Official Mascot</span>
          <h4 class="font-black text-slate-900 text-base">公式マスコット「えぬくま」</h4>
          <p class="text-xs text-slate-600 font-medium leading-relaxed">「全国のメンバーと一緒に、あなたの参加を心から楽しみに待っているよ！」</p>
        </div>
      </div>

    </div>
  </section>
</Layout>
