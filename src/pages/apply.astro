---
// src/pages/apply.astro
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout title={currentLang === 'en' ? "APPLY - Join Us" : "APPLY - メンバー募集"} activeKey="apply">
  <div class="max-w-5xl mx-auto px-4 py-12 md:py-20 space-y-16 w-full max-w-full box-border overflow-hidden">
    
    <!-- ▼ ヒーローセクション -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-950 shadow-2xl border border-slate-800/80 text-center py-16 px-6 md:p-20 max-w-4xl mx-auto w-full box-border">
      <!-- 背景画像 & グラデーションオーバーレイ -->
      <img src="/apply.jpg" alt="未来の防災とプロジェクト背景" class="absolute inset-0 w-full h-full object-cover object-center opacity-25 scale-105">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950/90 via-slate-950/85 to-indigo-950/90 backdrop-blur-[2px]"></div>
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 space-y-6 w-full min-w-0">
        <!-- タグバッジ -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-400 text-xs font-black tracking-widest uppercase">
          <span>MEMBER RECRUITMENT</span>
        </div>

        <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white leading-tight drop-shadow-md break-words">
          {currentLang === 'en' ? (
            <>
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-blue-200">Starting from the Noto Earthquake,</span>
              <br class="hidden sm:block">
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-blue-300 via-white to-indigo-200">Why not challenge the future with us</span>
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-blue-200">using your unique talents?</span>
            </>
          ) : (
            <>
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-blue-100">能登の震災を原点に、</span>
              <br class="hidden sm:block">
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-blue-300 via-white to-indigo-200">あなたの個性を活かして</span>
              <span class="inline-block bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-blue-100">一緒に未来へ挑みませんか？</span>
            </>
          )}
        </h2>
        
        <div class="w-16 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full"></div>
        
        <p class="text-slate-300 text-xs sm:text-sm md:text-base leading-relaxed max-w-2xl mx-auto font-medium opacity-95 break-words">
          {currentLang === 'en' ? (
            <>
              <span class="inline-block">At NSF PROJECTs, we are constantly recruiting</span>
              <span class="inline-block">student members nationwide to tackle disaster prevention</span>
              <span class="inline-block">and social issues beyond existing boundaries.</span><br class="hidden md:block">
              <span class="inline-block">There is always a place here</span>
              <span class="inline-block">where your individuality can shine.</span>
            </>
          ) : (
            <>
              <span class="inline-block">NSF PROJECTsでは、活動の枠組みを越えて、</span>
              <span class="inline-block">防災や社会課題に立ち向かう学生メンバーを</span>
              <span class="inline-block">全国から随時募集しています。</span><br class="hidden md:block">
              <span class="inline-block">あなたの個性を活かせる場所が、</span>
              <span class="inline-block">ここには必ずあります。</span>
            </>
          )}
        </p>
      </div>
    </div>

    <!-- ▼ プライバシーポリシー -->
    <div class="bg-white/90 backdrop-blur-xl border border-slate-200/90 rounded-3xl p-6 md:p-10 max-w-3xl mx-auto space-y-6 shadow-[0_10px_30px_rgba(0,0,0,0.04)] w-full box-border overflow-hidden">
      <div class="space-y-4 w-full">
        <h3 class="font-black text-slate-900 text-sm md:text-base border-b border-slate-100 pb-4 flex items-center break-words">
          <span class="w-2 h-5 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full mr-3 shrink-0"></span>
          {currentLang === 'en' ? 'Handling of Personal Information (Privacy Policy)' : '個人情報の取扱い（プライバシーポリシー）'}
        </h3>
        <p class="text-xs md:text-sm text-slate-600 leading-relaxed break-words">
          {currentLang === 'en' 
            ? 'NSF PROJECTs (hereinafter referred to as "the Project") properly manages personal information (name, contact info, Discord account, etc.) obtained during application and activities in accordance with personal information protection laws.' 
            : 'NSF PROJECTs（以下、「当プロジェクト」といいます）は、メンバー応募時および活動に際して取得した個人情報（氏名、連絡先、Discordアカウント等）について、個人情報保護法に基づき適切に管理いたします。'}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs md:text-sm text-slate-600 leading-relaxed pt-2 w-full">
          <div class="space-y-1.5 p-4 rounded-2xl bg-slate-50/80 border border-slate-100">
            <p class="font-black text-slate-900 break-words">
              {currentLang === 'en' ? '1. Purpose of Use' : '1. 利用目的'}
            </p>
            <p class="break-words">
              {currentLang === 'en' 
                ? 'Information will be used solely for activity-related communications, smooth collaboration among members, and project management.' 
                : '活動に関する連絡、メンバー間の円滑な連携、およびプロジェクト運営のためにのみ利用いたします。'}
            </p>
          </div>
          <div class="space-y-1.5 p-4 rounded-2xl bg-slate-50/80 border border-slate-100">
            <p class="font-black text-slate-900 break-words">
              {currentLang === 'en' ? '2. Prohibition of Third-Party Disclosure' : '2. 第三者提供の禁止'}
            </p>
            <p class="break-words">
              {currentLang === 'en' 
                ? 'Personal information will not be disclosed or provided to third parties without consent, except when required by law.' 
                : '法令に基づく場合を除き、ご本人の同意を得ることなく個人情報を第三者に提供・開示することはありません。'}
            </p>
          </div>
        </div>
      </div>
      <p class="text-center text-xs text-slate-400 font-bold border-t border-slate-100 pt-4 break-words">
        {currentLang === 'en' 
          ? '* Please agree to the handling of personal information above before joining our community.' 
          : '※上記の個人情報の取扱いに同意の上、コミュニティへご参加ください。'}
      </p>
    </div>

    <!-- ▼ 応募ボタン（CTA） -->
    <div class="flex flex-col items-center space-y-4 w-full px-2 box-border">
      <a 
        href="https://discord.gg/5kQJQ3fDwc" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group relative inline-flex items-center justify-center px-8 sm:px-12 py-4 md:py-5 font-black text-sm md:text-base text-white transition-all duration-300 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 rounded-full shadow-[0_10px_25px_rgba(37,99,235,0.35)] hover:shadow-[0_15px_35px_rgba(37,99,235,0.5)] -translate-y-0 hover:-translate-y-1 active:scale-95 text-center max-w-full border border-white/20"
      >
        <span class="mr-3 break-words tracking-wide">
          {currentLang === 'en' ? 'Agree and Join Discord' : '同意してDiscordに参加する'}
        </span>
        <svg class="w-5 h-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
      <p class="text-[11px] text-slate-400 font-bold uppercase tracking-widest text-center break-words flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Join our online community on Discord</span>
      </p>
    </div>

    <!-- ▼ 特徴セクション -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto w-full box-border">
      
      <!-- 特徴 1 -->
      <div class="bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/90 shadow-[0_10px_30px_rgba(0,0,0,0.03)] text-center space-y-4 flex flex-col justify-between overflow-hidden box-border hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-14 h-14 bg-gradient-to-br from-blue-50 to-indigo-50 text-blue-600 rounded-2xl border border-blue-100 flex items-center justify-center mx-auto mb-4 shrink-0 shadow-xs">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </div>
          <h3 class="font-black text-slate-900 text-base mb-2 break-words">
            {currentLang === 'en' ? 'Nationwide Network' : '全国に広がる仲間'}
          </h3>
          <p class="text-xs md:text-sm text-slate-500 leading-relaxed break-words font-medium">
            {currentLang === 'en' 
              ? 'Many peers interested in disaster prevention and social issues join us from all over Japan.' 
              : '全国から防災や社会課題に関心を持つ多くの仲間が参加しています。'}
          </p>
        </div>
      </div>
      
      <!-- 特徴 2 -->
      <div class="bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/90 shadow-[0_10px_30px_rgba(0,0,0,0.03)] text-center space-y-4 flex flex-col justify-between overflow-hidden box-border hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-14 h-14 bg-gradient-to-br from-amber-50 to-orange-50 text-amber-600 rounded-2xl border border-amber-100 flex items-center justify-center mx-auto mb-4 shrink-0 shadow-xs">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="font-black text-slate-900 text-base mb-2 break-words">
            {currentLang === 'en' ? 'Leverage Your Strengths' : '個性を活かす'}
          </h3>
          <p class="text-xs md:text-sm text-slate-500 leading-relaxed break-words font-medium">
            {currentLang === 'en' 
              ? 'Valuing each member’s ideas, you can freely launch and run new projects.' 
              : '一人ひとりの思いを大切に、新しいプロジェクトを自由に始められます。'}
          </p>
        </div>
      </div>
      
      <!-- 特徴 3 -->
      <div class="bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/90 shadow-[0_10px_30px_rgba(0,0,0,0.03)] text-center space-y-4 flex flex-col justify-between overflow-hidden box-border hover:-translate-y-1 transition duration-300">
        <div>
          <div class="w-14 h-14 bg-gradient-to-br from-emerald-50 to-teal-50 text-emerald-600 rounded-2xl border border-emerald-100 flex items-center justify-center mx-auto mb-4 shrink-0 shadow-xs">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="font-black text-slate-900 text-base mb-2 break-words">
            {currentLang === 'en' ? 'Collaborate on Discord' : 'Discordで連携'}
          </h3>
          <p class="text-xs md:text-sm text-slate-500 leading-relaxed break-words font-medium">
            {currentLang === 'en' 
              ? 'Utilizing online tools, members collaborate smoothly regardless of their region.' 
              : 'オンラインツールを活用し、地域を問わずスムーズに連携しています。'}
          </p>
        </div>
      </div>

    </div>

    <!-- ▼ マスコット -->
    <div class="mt-16 flex justify-center w-full box-border">
      <div class="bg-gradient-to-r from-blue-50/80 via-white to-indigo-50/80 p-6 md:p-8 rounded-3xl border border-blue-100 shadow-[0_10px_30px_rgba(0,0,0,0.03)] flex flex-col sm:flex-row items-center space-y-4 sm:space-y-0 sm:space-x-6 max-w-xl w-full box-border overflow-hidden">
        <div class="flex-shrink-0 p-2 bg-white rounded-2xl shadow-xs border border-slate-100">
          <img src="/IMG_1413.jpg" alt="えぬくま" class="w-20 h-20 sm:w-24 sm:h-24 object-contain rounded-xl">
        </div>
        <div class="text-center sm:text-left space-y-1.5 min-w-0">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 text-[10px] font-black tracking-wider uppercase">
            Official Mascot
          </span>
          <p class="text-slate-900 font-black text-base break-words">
            {currentLang === 'en' ? 'Official Mascot "Enukuma"' : '公式マスコット「えぬくま」'}
          </p>
          <p class="text-slate-600 text-xs sm:text-sm leading-relaxed break-words font-medium">
            {currentLang === 'en' 
              ? 'Together with members nationwide, I am truly looking forward to welcoming you!' 
              : '全国のメンバーと一緒に、あなたの参加を心から楽しみに待っているよ！'}
          </p>
        </div>
      </div>
    </div>

  </div>
</Layout>
