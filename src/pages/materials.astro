---
// src/pages/materials.astro
// レイアウト構造を一から刷新した新規設計デザイン

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
---

<Layout 
  title={currentLang === 'en' ? "Disaster Prevention Educational Games | NSF PROJECTs" : "防災教材・ゲーム一覧 | NSF PROJECTs"} 
  activeKey="materials"
>
  <section class="w-full bg-gradient-to-b from-slate-50 via-white to-blue-50/30 py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-12">
      
      <!-- ヘッダーレイアウト -->
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <span class="inline-block px-3.5 py-1 rounded-full bg-blue-50 border border-blue-200/80 text-blue-600 text-xs font-black tracking-widest uppercase">
          LEARN & PLAY
        </span>
        <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          {currentLang === 'en' ? 'Disaster Prevention WEB Games' : '防災WEBゲーム・教材'}
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
          {currentLang === 'en' 
            ? 'Interactive contents to learn disaster prevention while playing. Choose a game to start!' 
            : '遊びながら実践的な防災の知識が学べる体験型WEBコンテンツです。'}
        </p>
      </div>

      <!-- メインカードグリッド（2カラムレスポンシブ） -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        
        <!-- ゲーム1：防災リュックパケット -->
        <a 
          href={`/materials/backpack?lang=${currentLang}`} 
          class="group bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs hover:border-blue-500 hover:shadow-md transition-all duration-300 flex flex-col justify-between space-y-6"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-3xl shrink-0 group-hover:scale-105 transition-transform duration-300">
                🎒
              </div>
              <span class="text-[10px] font-black uppercase text-blue-600 bg-blue-50 border border-blue-100 px-3 py-1 rounded-full">
                Puzzle & Simulation
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg sm:text-xl font-black text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
                {currentLang === 'en' ? 'Emergency Backpack Packer' : '防災リュックパケット'}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
                {currentLang === 'en' 
                  ? 'Create the ultimate evacuation kit within a 10kg limit to save lives! Learn preparation tips like a puzzle.' 
                  : '持ち出し制限10kg以内で命を守る最強の避難セットを作ろう！パズル感覚で非常持出袋の準備とコツが学べます。'}
              </p>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-black text-blue-600">
            <span>{currentLang === 'en' ? 'Play Game' : 'ゲームをプレイする'}</span>
            <span class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-all duration-300 group-hover:translate-x-1">
              ➔
            </span>
          </div>
        </a>

        <!-- ゲーム2：3秒決断ゲーム -->
        <a 
          href={`/materials/3second-quiz?lang=${currentLang}`} 
          class="group bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-xs hover:border-amber-500 hover:shadow-md transition-all duration-300 flex flex-col justify-between space-y-6"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center text-3xl shrink-0 group-hover:scale-105 transition-transform duration-300">
                ⚡
              </div>
              <span class="text-[10px] font-black uppercase text-amber-600 bg-amber-50 border border-amber-100 px-3 py-1 rounded-full">
                Action & Decision
              </span>
            </div>

            <div class="space-y-2">
              <h2 class="text-lg sm:text-xl font-black text-slate-900 group-hover:text-amber-600 transition-colors leading-snug">
                {currentLang === 'en' ? '"What if an Earthquake Hits Right Now?" 3-Second Decision Game' : '「もしも今地震が来たら？」3秒決断ゲーム'}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
                {currentLang === 'en' 
                  ? 'Sudden shaking! Choose the correct safety action within 3 seconds to increase survival rates. Tests intuition and decision-making.' 
                  : '突然の大きな揺れ！3秒以内に正しい安全行動を選択し生存率を高めよう。とっさの判断力が試されます。'}
              </p>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-black text-amber-600">
            <span>{currentLang === 'en' ? 'Play Game' : 'ゲームをプレイする'}</span>
            <span class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 group-hover:translate-x-1">
              ➔
            </span>
          </div>
        </a>

      </div>

    </div>
  </section>
</Layout>
