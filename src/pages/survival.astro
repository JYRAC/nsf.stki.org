---
// src/pages/survival.astro
// オーロラグラデーション＆Glassmorphism強化版 NSFサバイバルアカデミー詳細ページ

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout 
  title={currentLang === 'en' ? "NSF Survival Academy | NSF PROJECTs" : "NSFサバイバルアカデミー | NSF PROJECTs"} 
  activeKey="projects"
>
  <!-- 背景オーロラグロー＆強力グラデーション -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-emerald-50/30 to-green-50/20 py-12 md:py-20">
    <!-- 光彩アクセント1 (左上) -->
    <div class="absolute -top-32 -left-20 w-[600px] h-[600px] bg-gradient-to-br from-emerald-400/20 via-teal-300/15 to-transparent rounded-full blur-[150px] pointer-events-none"></div>
    <!-- 光彩アクセント2 (中央右) -->
    <div class="absolute top-1/3 -right-24 w-[650px] h-[650px] bg-gradient-to-bl from-green-500/20 via-emerald-300/15 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">
      
      <!-- タイトルヘッダー -->
      <div class="text-center space-y-3 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-emerald-500/10 to-green-500/10 border border-emerald-300/40 text-emerald-700 text-xs font-black tracking-widest uppercase backdrop-blur-md shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>DISASTER PREVENTION & SURVIVAL SCHOOL</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-emerald-950 to-green-900">
            NSFサバイバルアカデミー
          </span>
        </h1>

        <div class="w-20 h-1.5 bg-gradient-to-r from-emerald-500 via-teal-400 to-green-600 mx-auto rounded-full shadow-xs"></div>
      </div>

      <!-- コンセプトカード -->
      <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
        <p class="text-slate-800 text-sm md:text-base leading-relaxed font-medium italic border-l-4 border-emerald-500 pl-4 sm:pl-6 py-1 break-words">
          {currentLang === 'en' ? (
            <>
              Not just a disaster prevention lecture or learning knowledge, but moving "from knowing to acting" and "from being taught to training."<br class="hidden md:block">
              An out-of-school disaster prevention school where middle and high school students learn life-saving skills for disaster situations through hands-on experience.
            </>
          ) : (
            <>
              単なる防災講演や知識学習ではなく、「知る防災」から「動ける防災」へ、「教わる防災」から「鍛える防災」へ。<br class="hidden md:block">
              中高生が実際に体験しながら災害対応力を身につけることを目的とした、「災害時に生き抜く力を、中高生が実際に体験しながら学ぶ学校外の防災スクール」です。
            </>
          )}
        </p>
      </div>

      <!-- プロジェクト概要 & コンセプト (12カラムグリッド) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- 左側：サイドバー（概要・コンセプト） -->
        <div class="lg:col-span-4 space-y-6">
          <div class="bg-slate-900 text-white p-6 sm:p-8 rounded-3xl border border-slate-800/80 shadow-lg space-y-6 relative overflow-hidden">
            <div class="w-full flex justify-center bg-white p-4 rounded-2xl border border-white/20 shadow-xs">
              <img src="/p_logo/survival.jpg" alt="NSFサバイバルアカデミー ロゴ" class="w-full h-auto max-h-36 object-contain rounded-xl">
            </div>

            <div class="space-y-4">
              <h3 class="font-black text-xs text-emerald-400 uppercase tracking-widest border-b border-slate-800 pb-2">
                Project Overview
              </h3>
              
              <div class="space-y-3">
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Project Leader' : 'プロジェクトリーダー'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'Jinn Takaesu' : '高江洲 義心'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Start Date' : '開始時期'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'December 2025' : '2025年12月'}
                  </p>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 font-bold uppercase">
                    {currentLang === 'en' ? 'Target Members' : '対象メンバー'}
                  </p>
                  <p class="text-sm font-black text-white break-words">
                    {currentLang === 'en' ? 'Middle, High School & College Students' : '中高生・大学生'}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-gradient-to-br from-emerald-900 via-teal-950 to-slate-950 text-white p-6 sm:p-8 rounded-3xl shadow-md border border-white/10 space-y-3">
            <span class="text-[10px] font-black uppercase text-emerald-300 bg-emerald-500/20 px-2.5 py-1 rounded-md border border-emerald-400/30">
              Concept
            </span>
            <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'The themes are "Disaster Prevention, Survival, Outdoor." We aim to build knowledge, decision-making skills, and adaptability required during disasters through hands-on workshops, training, and field activities.' 
                : 'テーマは「防災・サバイバル・アウトドア」。体験型ワークショップ・訓練・フィールド活動を通じて、災害時に必要な知識・判断力・適応力を身につけることを目指します。'}
            </p>
          </div>
        </div>

        <!-- 右側：具体的な活動内容 -->
        <div class="lg:col-span-8 bg-white/80 backdrop-blur-xl p-6 sm:p-8 md:p-10 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] flex flex-col justify-between space-y-8">
          <div class="space-y-6">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <span class="w-2.5 h-6 bg-gradient-to-b from-emerald-500 to-green-600 rounded-full shrink-0"></span>
              <h3 class="text-xl font-black text-slate-900 break-words">
                {currentLang === 'en' ? 'Activities & Initiatives' : '具体的な活動内容'}
              </h3>
            </div>
            
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Rather than just studying disaster prevention as knowledge, we plan and implement hands-on workshops, training, and field activities to foster the ability to "experience, judge, and act independently."' 
                : '防災を単なる知識として学ぶだけでなく、「実際に体験し、自ら判断し、行動する力」を養うため、体験型ワークショップ・訓練・フィールド活動を企画・実施しています。'}
            </p>

            <div class="space-y-4">
              <div class="bg-gradient-to-r from-emerald-50/80 to-green-50/50 p-5 sm:p-6 rounded-2xl border border-emerald-100/80 space-y-2">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="bg-emerald-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                    {currentLang === 'en' ? 'Practical Training' : '実践訓練'}
                  </span>
                  <h4 class="font-black text-slate-900 text-base break-words">
                    {currentLang === 'en' ? 'Experiencing Disaster Response Skills' : '災害対応スキルの体験'}
                  </h4>
                </div>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium pt-1 break-words">
                  {currentLang === 'en' 
                    ? 'Developing practical disaster response skills through command simulations during disaster dispatch, ropework, ranger training basics, and decision-making drills at disaster sites.' 
                    : '災害派遣時の指揮シミュレーション、ロープワーク、レンジャー訓練の基礎体験、災害現場での判断訓練などを通じて、実践的な災害対応力を養います。'}
                </p>
              </div>

              <div class="bg-gradient-to-r from-teal-50/80 to-emerald-50/50 p-5 sm:p-6 rounded-2xl border border-teal-100/80 space-y-2">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="bg-teal-600 text-white font-black text-[10px] px-2.5 py-0.5 rounded-md shrink-0 shadow-xs">
                    {currentLang === 'en' ? 'Future Vision' : '将来構想'}
                  </span>
                  <h4 class="font-black text-slate-900 text-base break-words">
                    {currentLang === 'en' ? 'Toward a Continuous Educational Brand' : '継続的な教育ブランドへ'}
                  </h4>
                </div>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium pt-1 break-words">
                  {currentLang === 'en' 
                    ? 'We envision evolving from single events into an educational brand that continuously conducts camping, mountain climbing, field training, disaster drills, simulations, and collaboration with JSDF, fire departments, and local governments.' 
                    : '単発のイベントではなく、キャンプ・登山・野営・防災訓練・災害対応シミュレーション、自衛隊・消防・自治体との連携を継続的に行う教育ブランドへの発展を構想しています。'}
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 開催実績 -->
      <div class="space-y-8 max-w-5xl mx-auto">
        <div class="text-center space-y-2">
          <h3 class="text-xl sm:text-2xl font-black text-slate-900">
            {currentLang === 'en' ? 'Event History' : '開催実績'}
          </h3>
          <div class="w-12 h-1 bg-gradient-to-r from-emerald-500 to-green-500 mx-auto rounded-full"></div>
        </div>

        <div class="space-y-6">
          <!-- 第1回 -->
          <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="bg-emerald-600 text-white font-black text-[10px] px-3 py-1 rounded-full shrink-0 shadow-xs">
                {currentLang === 'en' ? '1st Event' : '第1回'}
              </span>
              <span class="text-xs font-bold text-slate-400">
                {currentLang === 'en' ? 'February 8, 2026' : '2026年2月8日'}
              </span>
            </div>

            <h4 class="font-black text-slate-900 text-lg sm:text-xl break-words">
              {currentLang === 'en' ? '1st Survival Academy' : '第1回 サバイバルアカデミー'}
            </h4>

            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Held as an after-event of NSF PROJECTs and the National High School Future Conference. Co-hosted by JSDF Tokyo Provincial Cooperation Office, held at Shibuya Recruiting Information Center.' 
                : 'NSF PROJECTs・全国高校生未来会議のアフターイベントとして実施。共催は防衛省自衛隊東京地方協力本部、会場は渋谷募集案内所でした。'}
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/60 text-xs font-bold px-3 py-1.5 rounded-xl break-words">
                {currentLang === 'en' ? 'Disaster Dispatch Command Simulation' : '災害派遣時の指揮シミュレーション'}
              </span>
              <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/60 text-xs font-bold px-3 py-1.5 rounded-xl break-words">
                {currentLang === 'en' ? 'Ropework' : 'ロープワーク'}
              </span>
              <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/60 text-xs font-bold px-3 py-1.5 rounded-xl break-words">
                {currentLang === 'en' ? 'Ranger Training Basics' : 'レンジャー訓練の基礎体験'}
              </span>
              <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/60 text-xs font-bold px-3 py-1.5 rounded-xl break-words">
                {currentLang === 'en' ? 'Disaster Site Decision Drill' : '災害現場での判断訓練'}
              </span>
            </div>
          </div>

          <!-- 第2回 -->
          <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="bg-emerald-600 text-white font-black text-[10px] px-3 py-1 rounded-full shrink-0 shadow-xs">
                {currentLang === 'en' ? '2nd Event' : '第2回'}
              </span>
              <span class="text-xs font-bold text-slate-400">
                {currentLang === 'en' ? 'April 25 (Sat) – 26 (Sun), 2026' : '2026年4月25日（土）〜26日（日）'}
              </span>
            </div>

            <div>
              <h4 class="font-black text-slate-900 text-lg sm:text-xl break-words">
                {currentLang === 'en' ? 'NSF Survival Academy 2026 Spring' : 'NSFサバイバルアカデミー2026春'}
                <span class="block sm:inline sm:ml-2 text-slate-500 text-sm sm:text-base font-bold">
                  {currentLang === 'en' ? ' ~ Survival Skills at Asaka Camp ~' : ' 〜朝霞駐屯地で学ぶ、災害時に生き抜く力〜'}
                </span>
              </h4>
              <p class="text-xs font-bold text-slate-400 mt-1">
                {currentLang === 'en' ? '(2nd Cardboard Bed Camp)' : '（NSFサバイバルアカデミー 第2回 段ボールベッドキャンプ）'}
              </p>
            </div>

            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Learned disaster prevention, first aid, and survival techniques during a 2-day 1-night camp around JSDF Asaka Camp in Saitama. Under the theme "From knowing to doing," students acquired essential skills through experience. It also served as a venue for students nationwide to connect.' 
                : '埼玉県の朝霞駐屯地周辺において、1泊2日の共同生活で防災・救命・サバイバル技術を学びました。「知る防災から、できる防災へ」をテーマに、講義ではなく実際の体験を通して災害時に必要な知識や技術を習得。全国から集まった中高生・大学生の交流の場にもなりました。'}
            </p>

            <div class="bg-slate-50/80 p-5 rounded-2xl border border-slate-200/60 space-y-3">
              <p class="text-[10px] text-slate-500 font-black uppercase tracking-widest">
                {currentLang === 'en' ? 'PROGRAM DETAILS' : '実施プログラム'}
              </p>
              <ol class="space-y-2 text-slate-700 text-xs sm:text-sm font-medium list-decimal list-inside marker:text-emerald-600 marker:font-black break-words">
                {currentLang === 'en' ? (
                  <>
                    <li>Tent pitching practice</li>
                    <li>Emergency first aid practice (CPR using AED, hemostasis training with trauma models, blanket transport training)</li>
                    <li>Cardboard bed overnight experience</li>
                    <li>Night Vision Goggles (NVG) experience</li>
                    <li>Night survival program (making plastic bottle lanterns, etc.)</li>
                    <li>JSDF meal experience (dining in mess hall and heated emergency ration experience)</li>
                    <li>Rikkun Land (JSDF Public Relations Center) tour</li>
                  </>
                ) : (
                  <>
                    <li>天幕設営体験</li>
                    <li>応急救護体験（AEDを用いた心肺蘇生法、戦傷模型を活用した止血法、毛布を使用した搬送訓練）</li>
                    <li>段ボールベッド宿泊体験</li>
                    <li>暗視眼鏡（NVG）体験</li>
                    <li>夜間サバイバルプログラム（ペットボトルランタン作成 ほか）</li>
                    <li>自衛隊喫食体験（隊員食堂での喫食・携行食の加温体験）</li>
                    <li>りっくんランド見学</li>
                  </>
                )}
              </ol>
            </div>
          </div>

          <!-- 第3回 -->
          <div class="bg-white/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="bg-emerald-600 text-white font-black text-[10px] px-3 py-1 rounded-full shrink-0 shadow-xs">
                {currentLang === 'en' ? '3rd Event' : '第3回'}
              </span>
              <span class="text-xs font-bold text-slate-400">
                {currentLang === 'en' ? 'June 14, 2026 (Sun)' : '2026年6月14日（日）'}
              </span>
            </div>

            <div>
              <h4 class="font-black text-slate-900 text-lg sm:text-xl break-words">
                {currentLang === 'en' ? 'Disaster Prevention Lecture × Idea Contest' : '防災講話 × アイデアコンテスト'}
                <span class="block sm:inline sm:ml-2 text-slate-500 text-sm sm:text-base font-bold">
                  {currentLang === 'en' ? ' ~ What if a disaster strikes this town? Can you act? ~' : ' 〜もしもこの町で災害が起きたら？あなたは動けるか。〜'}
                </span>
              </h4>
            </div>

            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Held at JSDF Shibuya Recruiting Information Center (offline) and Zoom (online). Hosted an idea contest under the theme "How to raise awareness of JSDF through disaster support and prevention." The lecture featured a disaster prevention manager who served in key positions such as the 1st Airborne Brigade.' 
                : '防衛省自衛隊渋谷募集案内所（オフライン）およびZoom（オンライン）にて開催。「災害支援や防災を通じて、自衛隊のことを知ってもらうには」をテーマとしたアイデアコンテストを実施しました。また防災講話では、第一空挺団や帯広地方協力本部本部長などの著名な役職を務められた現・防災推進担当課長の方に、実践的なお話を登壇いただきました。'}
            </p>

            <div class="bg-slate-50/80 p-5 rounded-2xl border border-slate-200/60 space-y-3">
              <p class="text-[10px] text-slate-500 font-black uppercase tracking-widest">
                {currentLang === 'en' ? 'MAIN HIGHLIGHTS' : '主な内容・特徴'}
              </p>
              <ul class="space-y-2 text-slate-700 text-xs sm:text-sm font-medium list-disc list-inside marker:text-emerald-600 break-words">
                {currentLang === 'en' ? (
                  <>
                    <li>Idea contest to deepen awareness and understanding of the JSDF</li>
                    <li>Disaster prevention lecture by a professional with a background in the 1st Airborne Brigade</li>
                    <li>Opportunity for top winners to present ideas directly to the Tokyo Provincial Cooperation Office Director (under coordination)</li>
                  </>
                ) : (
                  <>
                    <li>自衛隊の認知・理解を深めるためのアイデアコンテストの実施</li>
                    <li>元・第一空挺団等の経歴を持つ防災のプロフェッショナルによる防災講話</li>
                    <li>上位入賞者が東京地方協力本部本部長へアイデアを直接提言できる機会の創出（調整中）</li>
                  </>
                )}
              </ul>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
