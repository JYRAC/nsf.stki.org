---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";

// 第7期 幹部メンバーの定義 (日英対応)
const executives = [
  {
    role: currentLang === 'en' ? "Co-President" : "共同代表",
    name: currentLang === 'en' ? "Kenshin Kitamura" : "北村 謙心",
    message: currentLang === 'en' 
      ? "To raise awareness about disaster prevention, it is crucial that everyone has a sense of personal responsibility. Joining NSF PROJECTS is the easiest way to start[cite: 1]! Let's take a step together toward making Japan a disaster-resilient nation[cite: 1]!" 
      : "NSF PROJECTsの団体理念には「中高生の防災意識向上」がありますが、僕は防災の意識を向上させるためには、全員が当事者意識を持つことが大事だと思っています。探してその1番手軽な方法がNSF PROJECTSに入ることです！入れない人でもこれからのNSFの活躍を見守ってこの日本を防災大国にする一歩を一緒に踏み出しましょう！",
    img: "/p_logo/Kitamura.jpg",
    style: "object-cover object-top"
  },
  {
    role: currentLang === 'en' ? "Vice President" : "副代表",
    name: currentLang === 'en' ? "Momo Yoshida" : "吉田 桃",
    message: currentLang === 'en' 
      ? "I want to create opportunities for middle and high school students nationwide to lead disaster prevention activities[cite: 1]. Why not join us in shaping 'Disaster Prevention x Something New' that only youth can create?" 
      : "日本全国の中高生が防災活動の主体になるきっかけを創っていきます[cite: 1]。中高生だからこそ生み出せる「防災×○○」を一緒に形にしてみませんか？",
    img: "/p_logo/Yoshida.jpg",
    style: "object-cover object-[70%_center]"
  },
  {
    role: currentLang === 'en' ? "Vice President" : "副代表",
    name: currentLang === 'en' ? "Yuka Oki" : "大木 優歌",
    message: currentLang === 'en' 
      ? "I cherish each member's thoughts and aim to create opportunities to think about disaster preparedness in daily life, not just after a disaster strikes. I hope to make disaster prevention approachable for everyone." 
      : "副代表として、メンバー一人ひとりの想いを大切にしながら、災害が起きてからではなく、日常から防災について考えられるきっかけをつくっていきたいです。「防災って難しそう」と感じる人にも興味を持ってもらえるような活動を通して、より多くの人が防災を自分ごととして捉え、行動につなげられるNSFを目指します！",
    img: "/p_logo/Ooki.jpg",
    style: "object-cover object-top"
  },
  {
    role: currentLang === 'en' ? "Vice President" : "副代表",
    name: currentLang === 'en' ? "Sora Nishiyama" : "西山 空澄",
    message: currentLang === 'en' 
      ? "Focusing on human connections, I hope to help NSF become an organization where all members can deepen their understanding of disaster prevention and be honest with what they want to achieve." 
      : "人と人との繋がりを意識しながら、メンバー全員が防災に関して考えを深められるような団体になるようにお手伝いができたら嬉しいです。自分の「やりたい」に正直になれるような団体にしたいです。",
    img: "/p_logo/Nishiyama.jpg",
    style: "object-cover object-top"
  },
  {
    role: currentLang === 'en' ? "Head of External Affairs" : "外務統括",
    name: currentLang === 'en' ? "Harune Iwasiro" : "岩城 遥音",
    message: currentLang === 'en' 
      ? "Living in a disaster-prone country like Japan, disaster preparedness is a theme we can never turn our backs on. We would be thrilled to have your support for our activities!" 
      : "防災大国日本に生きる以上、災害や防災は私たちが絶対に目を背けられないテーマだと思います。ぜひ私たちの活動を応援してくださるとめちゃくちゃ嬉しいです！",
    img: "/p_logo/Iwaki.jpg",
    style: "object-cover object-top"
  },
  {
    role: currentLang === 'en' ? "Head of Public Relations" : "広報統括",
    name: currentLang === 'en' ? "Fuu Kanda" : "神田 ふう",
    message: currentLang === 'en' 
      ? "I will do my absolute best to share the charm and appeal of NSF with everyone! Thank you for your support." 
      : "NSFの魅力を伝えられるよう、精一杯頑張ります！よろしくお願いします。",
    img: "/p_logo/Kanda.jpg",
    style: "object-cover object-top"
  },
  {
    role: currentLang === 'en' ? "Head of IT & Information" : "情報統括",
    name: currentLang === 'en' ? "Shugo Takamori" : "高森 柊吾",
    message: currentLang === 'en' 
      ? "I'm a unique student council president living in Aomori Prefecture! I will fully support everyone from afar!" 
      : "青森県に住んでいる変な生徒会長です！遠くから皆さんを補助りまくっちゃいます！よろしくお願いします！！",
    img: "/p_logo/Takamori.jpg",
    style: "object-cover object-center"
  },
  {
    role: currentLang === 'en' ? "Head of General Affairs" : "総務統括",
    name: currentLang === 'en' ? "Kazuki Makino" : "牧野 一貴",
    message: currentLang === 'en' 
      ? "I oversee HR and planning. Valuing members' voices, I aim to connect people and ideas to make NSF an active and encouraging place for new challenges!" 
      : "人事と企画の統括をしています。メンバーの声を大切にしながら、人と人、想いと活動をつなぎ、NSFをさらに活発で挑戦しやすい場所にしていきます！",
    img: "/p_logo/Makino.jpg",
    style: "object-cover object-top"
  },
];
---

<Layout title={currentLang === 'en' ? "ABOUT — NSF PROJECTs" : "ABOUT — NSF PROJECTs"} activeKey="about">
  <!-- ヒーローセクション（新デザインを踏襲） -->
  <section class="relative min-h-[500px] md:min-h-[600px] overflow-hidden bg-[radial-gradient(circle_at_75%_25%,rgba(36,213,232,0.25),transparent_35%),linear-gradient(135deg,#eef7ff_0%,#fff_48%,#eaf7ff_100%)] px-6 md:px-16 pt-32 pb-20 flex items-center">
    <!-- 背景アクセントグラデーション -->
    <div class="absolute w-[500px] h-[500px] rounded-full -right-40 -bottom-52 bg-gradient-to-br from-blue-500/10 to-cyan-400/20 blur-xl pointer-events-none"></div>
    
    <!-- クリスタル要素 -->
    <div class="hidden md:block absolute w-44 h-44 rotate-[32deg] -skew-x-[7deg] border border-blue-500/20 bg-gradient-to-br from-white/70 to-cyan-400/15 backdrop-blur-md [clip-path:polygon(50%_0,100%_24%,82%_100%,20%_88%,0_30%)] animate-[float_8s_ease-in-out_infinite] right-[10%] top-[20%] pointer-events-none"></div>
    <div class="hidden md:block absolute w-24 h-24 rotate-[38deg] -skew-x-[7deg] border border-blue-500/15 bg-gradient-to-br from-white/60 to-cyan-400/10 backdrop-blur-md [clip-path:polygon(50%_0,100%_24%,82%_100%,20%_88%,0_30%)] animate-[float_8s_ease-in-out_infinite] left-[5%] bottom-[15%] [animation-delay:-3s] pointer-events-none"></div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center md:text-left">
      <div class="text-xs font-black tracking-[0.25em] text-[#1769ff] mb-4 uppercase">WHO WE ARE</div>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-[#081426] leading-none mb-6">
        {currentLang === 'en' ? (
          <>Restoring Normalcy.<br/><span class="text-[#1769ff]">Together.</span></>
        ) : (
          <>震災前の当たり前を、<br/><span class="text-[#1769ff]">学生の手で。</span></>
        )}
      </h1>
      <p class="max-w-2xl text-slate-600 text-sm md:text-base leading-relaxed font-medium">
        {currentLang === 'en' 
          ? 'Over 500 middle and high school students nationwide join hands to deliver support from the perspective of disaster-affected areas and promote disaster prevention actions.' 
          : '能登半島地震を原点に、全国500名以上の中高生が手を取り合い、被災地と同じ目線に立った支援と未来をつくる防災アクションを展開しています。'}
      </p>
    </div>
  </section>

  <!-- 代表メッセージ（ABOUTセクション風デザイン: ダーク背景 #081426） -->
  <section class="bg-[#081426] text-white py-20 md:py-28 px-6 md:px-16 relative overflow-hidden">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- 代表写真 -->
      <div class="lg:col-span-5 relative">
        <div class="w-full aspect-[3/4] rounded-[32px] overflow-hidden bg-gradient-to-br from-[#173b72] to-[#1bcddd] relative shadow-2xl border border-white/10">
          <img 
            src="/p_logo/Takada.jpg" 
            alt="NSF 代表 高田 翔大" 
            class="w-full h-full object-cover relative z-10"
            onerror="this.style.display='none';"
          />
          <!-- ウォーターマークテキスト -->
          <span class="absolute -left-3 -bottom-8 font-black text-9xl tracking-tighter opacity-10 text-white select-none z-0">NSF</span>
        </div>
      </div>

      <!-- 代表メッセージ本文 -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <div class="text-xs font-black tracking-[0.2em] text-[#24d5e8] uppercase mb-2">REPRESENTATIVE MESSAGE</div>
          <h2 class="text-3xl md:text-5xl font-black tracking-tight leading-tight">
            {currentLang === 'en' ? 'Empowering Youth Action for Recovery.' : '中高生一人ひとりが\n「防災」と「復興」の主体へ。'}
          </h2>
        </div>

        <div class="border-l-4 border-[#1769ff] pl-4 py-1">
          <p class="text-[#24d5e8] font-bold text-sm md:text-base">
            {currentLang === 'en' 
              ? '― Restoring hope and building a resilient future together ―' 
              : '― 被災地とともに歩み、未来の防災を変える力を育む ―'}
          </p>
        </div>

        <div class="text-[#aebbd0] text-sm md:text-base leading-relaxed space-y-4 font-normal">
          {currentLang === 'en' ? (
            <>
              <p>Our goal for this term is to revitalize projects within NSF and build a framework where every member can engage in disaster prevention and recovery activities tailored to their interests.</p>
              <p>We believe that when youth across Japan take action, it builds real power to protect lives and shape a safer future.</p>
              <p>We will dedicate all our efforts to making NSF a place where every member can continually take on new challenges.</p>
            </>
          ) : (
            <>
              <p>NSFに存在するプロジェクトを活性化させ、NSFに所属する全員が、それぞれに興味のある側面で「防災」と「復興」に関する活動を行える仕組みを作ることが、今期のゴールです。</p>
              <p>中高生一人ひとりの「やりたい」という想いや関心を行動に移すことが、誰かの命を守り、未来の防災を変える力になると信じています。</p>
              <p>メンバー全員が主体となって挑戦を続けられる組織を目指し、全力で努力していきます！</p>
            </>
          )}
        </div>

        <div class="pt-4 border-t border-white/10 flex items-baseline gap-3">
          <span class="text-xs font-bold text-slate-400">
            {currentLang === 'en' ? 'NSF PROJECTs 7th Term Leader' : 'NSF PROJECTs 第7期代表'}
          </span>
          <span class="text-xl md:text-2xl font-black text-white tracking-wide">
            {currentLang === 'en' ? 'Shota Takada' : '高田 翔大'}
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- 幹部メンバー紹介（MEMBERSセクションデザイン） -->
  <section class="bg-[#f6f9fc] py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[#dfe8f3] pb-6">
        <div>
          <div class="text-xs font-black tracking-[0.22em] text-[#1769ff] uppercase">EXECUTIVE MEMBERS</div>
          <h2 class="text-3xl md:text-5xl font-black text-[#081426] tracking-tight mt-1">人が、NSFを動かす。</h2>
        </div>
        <p class="text-xs font-bold text-slate-400">
          {currentLang === 'en' ? 'Leading 500+ Members Nationwide' : '全国500名超のメンバーを牽引する幹部メンバー'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {executives.map((member) => (
          <div class="bg-white border border-[#dfe8f3] rounded-[24px] overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl flex flex-col justify-between">
            <div>
              <!-- アバター枠 -->
              <div class="h-64 bg-gradient-to-br from-[#dceeff] to-[#bdeef4] relative overflow-hidden">
                <img 
                  src={member.img} 
                  alt={member.name} 
                  class={`w-full h-full ${member.style}`}
                  onerror="this.style.display='none';"
                />
              </div>
              
              <!-- メンバー情報 -->
              <div class="p-6 space-y-2">
                <span class="text-[10px] font-black tracking-widest text-[#1769ff] uppercase block">
                  {member.role}
                </span>
                <h3 class="text-lg font-black text-[#081426]">{member.name}</h3>
                <p class="text-xs text-slate-600 leading-relaxed font-medium italic pt-2">
                  「{member.message}」
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 応援メッセージ（SOCIAL/CARDデザイン風） -->
  <section class="bg-white py-20 md:py-28 px-6 md:px-16">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <div>
        <div class="text-xs font-black tracking-[0.22em] text-[#1769ff] uppercase">SUPPORTERS</div>
        <h2 class="text-3xl md:text-5xl font-black text-[#081426] tracking-tight mt-1">応援メッセージ</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- 坂井学氏 -->
        <div class="bg-[#f7faff] border border-[#dfe8f3] rounded-[26px] p-8 md:p-10 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center space-x-4 border-b border-[#dfe8f3] pb-4">
              <div class="w-16 h-16 rounded-full overflow-hidden bg-gradient-to-br from-blue-100 to-cyan-100 border border-slate-200 shrink-0">
                <img src="/p_logo/sakai.jpg" alt="坂井学氏" class="w-full h-full object-cover" onerror="this.style.display='none';">
              </div>
              <div>
                <span class="text-[10px] font-black text-[#1769ff] tracking-wider uppercase block">
                  {currentLang === 'en' ? 'Minister of State for Disaster Management' : '前 防災特命大臣'}
                </span>
                <h3 class="text-lg md:text-xl font-black text-[#081426]">
                  {currentLang === 'en' ? 'Manabu Sakai' : '坂井 学 氏'}
                </h3>
              </div>
            </div>
            <p class="text-slate-600 text-xs md:text-sm leading-relaxed italic border-l-2 border-[#1769ff] pl-4 py-1 font-medium">
              {currentLang === 'en' 
                ? 'I pay my respects to your dedication to learning, thinking, and discussing disaster prevention with an eye toward the future. Disaster preparedness is vital wisdom to protect lives and livelihoods. Cultivate your own leadership while looking one step ahead with wisdom and courage. I have high expectations for your endeavors.' 
                : '未来を見据え、防災について学び、考え、語り合おうとするみなさんの姿勢に、心から敬意を表します。防災は命と暮らしを守る大切な知恵であり誰もが向き合うべきテーマです。知恵と胆力を携え、一歩先を見据えながら、自分らしいリーダーシップを育んでください。皆さんの挑戦に大きな期待を寄せています。'}
            </p>
          </div>
        </div>

        <!-- 馳浩氏 -->
        <div class="bg-[#f7faff] border border-[#dfe8f3] rounded-[26px] p-8 md:p-10 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center space-x-4 border-b border-[#dfe8f3] pb-4">
              <div class="w-16 h-16 rounded-full overflow-hidden bg-gradient-to-br from-blue-100 to-cyan-100 border border-slate-200 shrink-0">
                <img src="/p_logo/komaba.jpg" alt="馳浩氏" class="w-full h-full object-cover" onerror="this.style.display='none';">
              </div>
              <div>
                <span class="text-[10px] font-black text-[#1769ff] tracking-wider uppercase block">
                  {currentLang === 'en' ? 'Governor of Ishikawa Prefecture' : '石川県知事'}
                </span>
                <h3 class="text-lg md:text-xl font-black text-[#081426]">
                  {currentLang === 'en' ? 'Hiroshi Hase' : '馳 浩 氏'}
                </h3>
              </div>
            </div>
            <p class="text-slate-600 text-xs md:text-sm leading-relaxed italic border-l-2 border-[#1769ff] pl-4 py-1 font-medium">
              {currentLang === 'en'
                ? 'Noto suffered significant damage from the Noto Peninsula Earthquake on New Year’s Day 2024, and we are currently working full force on recovery. I understand that you have engaged in fundraising and are now working to share Noto’s charm nationwide. Such efforts encourage the people of Noto and provide strong momentum for recovery. As Governor of Ishikawa Prefecture, I deeply appreciate your work.'
                : '能登では、令和６年元日の能登半島地震等で大きな被害が発生し、現在、復旧・復興に全力で取り組んでいます。皆さんは募金活動などに取り組まれ、今回、能登の魅力を全国に発信する活動をされるとお聞きしました。こうした取組は、能登の人々に勇気を与え、能登の復興の大きな後押しになるものと考えています。石川県知事として深く感謝申し上げます。'}
            </p>
          </div>
        </div>

      </div>

      <p class="text-slate-400 text-center font-bold italic text-[11px] md:text-xs">
        {currentLang === 'en' 
          ? '* Titles are based on the position at the time the message was provided.' 
          : '※各氏の肩書はメッセージ提供当時の役職に基づいています。'}
      </p>
    </div>
  </section>

  <!-- 公式マスコット「えぬくま」 -->
  <section class="bg-[#eef5fb] py-16 px-6 md:px-16 border-t border-[#dfe8f3]">
    <div class="max-w-4xl mx-auto bg-white border border-[#dfe8f3] rounded-[28px] p-8 md:p-10 flex flex-col sm:flex-row items-center gap-6 sm:gap-10 shadow-sm">
      <img src="/IMG_1413.jpg" alt="えぬくま" class="w-24 h-24 md:w-28 md:h-28 object-contain shrink-0">
      <div class="text-center sm:text-left space-y-2">
        <div class="text-xs font-black tracking-[0.2em] text-[#1769ff] uppercase">OFFICIAL MASCOT</div>
        <h4 class="text-lg md:text-xl font-black text-[#081426]">公式キャラクター「えぬくま」</h4>
        <p class="text-slate-600 text-xs md:text-sm leading-relaxed font-medium">
          {currentLang === 'en' 
            ? 'Meet "Enukuma", our official mascot! Dressed in a helmet and school uniform, Enukuma cheers for the future of Noto every day alongside over 500 middle and high school members nationwide!' 
            : 'ヘルメットと学生服を身にまとった公式キャラクターの「えぬくま」君です。全国500名以上の中高生メンバーと一緒に、能登の未来を毎日応援しています！'}
        </p>
      </div>
    </div>
  </section>

  <!-- CTA セクション（JOIN THE ACTION） -->
  <section class="bg-gradient-to-r from-[#0b1a30] to-[#1263c9] text-white py-24 px-6 md:px-16 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto space-y-6 relative z-10">
      <div class="text-xs font-black tracking-[0.25em] text-[#24d5e8] uppercase">JOIN THE ACTION</div>
      <h2 class="text-4xl sm:text-6xl font-black tracking-tight leading-none">
        YOUR ACTION<br/>CAN CHANGE THE FUTURE.
      </h2>
      <p class="text-slate-300 text-sm md:text-base font-medium">
        あなたもNSF PROJECTsで、未来を変える一歩を踏み出しませんか？
      </p>
      <div class="pt-4">
        <a href="#contact" class="inline-block bg-white text-[#081426] px-8 py-4 rounded-[15px] text-xs font-extrabold transition-transform duration-200 hover:-translate-y-1 shadow-lg">
          CONTACT →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(32deg) skew(-7deg); }
    50% { transform: translateY(-20px) rotate(38deg) skew(-7deg); }
  }
</style>
