---
// src/pages/contact.astro
// ホワイトテーマ・近未来感あふれる洗練されたモダンUIに全面リデザイン

import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout title={currentLang === 'en' ? "CONTACT - Contact Us" : "CONTACT - お問い合わせ"} activeKey="contact">
  <!-- 背景オーロラオーナメント（ホワイト・ライトブルー基調） -->
  <div class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-blue-50/40 text-slate-900 py-12 md:py-24">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-blue-200/40 via-indigo-100/30 to-purple-100/20 blur-[130px] pointer-events-none rounded-full"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-blue-100/60 blur-[100px] pointer-events-none rounded-full"></div>

    <div class="max-w-5xl mx-auto px-4 space-y-16 w-full relative z-10 box-border">
      
      <!-- ▼ ヒーローセクション（タイトル） -->
      <div class="text-center space-y-6 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-200/80 text-blue-600 text-xs font-black tracking-widest uppercase shadow-xs">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span>GET IN TOUCH</span>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight break-words">
          {currentLang === 'en' ? (
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-900">
              Contact Us
            </span>
          ) : (
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-900">
              お問い合わせ
            </span>
          )}
        </h2>

        <div class="w-16 h-1.5 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 mx-auto rounded-full shadow-xs"></div>

        <p class="text-slate-600 text-sm md:text-base leading-relaxed font-semibold break-words max-w-2xl mx-auto">
          {currentLang === 'en' ? (
            <>
              Inquiries regarding NSF and requests for materials are accepted here.<br class="hidden sm:block">
              Please feel free to contact us with any questions, feedback, or interview requests.
            </>
          ) : (
            <>
              NSFに関するお問い合わせ、資料のご請求はこちらから承っております。<br class="hidden sm:block">
              ご意見・取材依頼など、お気軽にお問い合わせください。
            </>
          )}
        </p>
      </div>

      <!-- ▼ お問い合わせ窓口 3選（ハイライト構造） -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch max-w-5xl mx-auto w-full box-border">
        
        <!-- メール -->
        <div class="group bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:border-blue-400 hover:shadow-[0_15px_35px_rgba(37,99,235,0.08)] transition-all duration-300 flex flex-col items-center text-center justify-between space-y-6 hover:-translate-y-1">
          <div class="flex flex-col items-center space-y-4 w-full">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-50 to-indigo-50 text-blue-600 rounded-2xl border border-blue-100 flex items-center justify-center shrink-0 shadow-xs group-hover:scale-110 transition duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="text-base font-black text-slate-900 tracking-wide break-words">
              {currentLang === 'en' ? 'Email Inquiry' : 'メールでのお問い合わせ'}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Please email us directly for general consultations, document requests, media inquiries, or interview requests.' 
                : '各種ご相談、資料請求、広報・取材のご依頼などはこちらのアドレスへ直接ご連絡ください。'}
            </p>
          </div>
          <a href="mailto:pr@jyrac.stki.org" class="text-blue-600 font-black text-sm hover:underline break-all tracking-tight pt-2">
            pr@jyrac.stki.org
          </a>
        </div>

        <!-- Googleフォーム (メインCTAカード) -->
        <div class="group relative bg-gradient-to-b from-blue-600 via-indigo-600 to-blue-700 p-8 rounded-3xl shadow-[0_15px_40px_rgba(37,99,235,0.28)] hover:shadow-[0_20px_50px_rgba(37,99,235,0.4)] flex flex-col items-center text-center justify-between space-y-6 text-white transition-all duration-300 hover:-translate-y-1 border border-white/20">
          <div class="flex flex-col items-center space-y-4 w-full">
            <div class="w-14 h-14 bg-white/10 text-white rounded-2xl border border-white/20 flex items-center justify-center shrink-0 group-hover:scale-110 transition duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3 class="text-base font-black tracking-wide break-words">
              {currentLang === 'en' ? 'Inquiry Form' : 'お問い合わせフォーム'}
            </h3>
            <p class="text-xs text-blue-100 leading-relaxed font-medium break-words opacity-90">
              {currentLang === 'en' 
                ? 'Available 24/7 via Google Forms. Please fill out the required items and submit.' 
                : 'Googleフォームを使用して24時間受け付けております。必要事項をご記入の上、送信してください。'}
            </p>
          </div>
          <a href="https://forms.gle/34JkMTyqU2xskQzW7" target="_blank" rel="noopener noreferrer" class="w-full bg-white hover:bg-slate-50 text-blue-600 font-black text-xs py-4 rounded-full shadow-md transition-all duration-200 inline-block text-center break-words group-hover:shadow-lg">
            {currentLang === 'en' ? 'Open Inquiry Form ➔' : 'お問い合わせフォームを開く ➔'}
          </a>
        </div>

        <!-- 公式Instagram -->
        <div class="group bg-white/90 backdrop-blur-xl p-8 rounded-3xl border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:border-orange-400 hover:shadow-[0_15px_35px_rgba(249,115,22,0.08)] transition-all duration-300 flex flex-col items-center text-center justify-between space-y-6 hover:-translate-y-1">
          <div class="flex flex-col items-center space-y-4 w-full">
            <div class="w-14 h-14 bg-gradient-to-br from-amber-50 to-orange-50 text-orange-600 rounded-2xl border border-orange-100 flex items-center justify-center shrink-0 shadow-xs group-hover:scale-110 transition duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-base font-black text-slate-900 tracking-wide break-words">
              {currentLang === 'en' ? 'Official Instagram (DM)' : '公式Instagram (DM)'}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Feel free to contact us via Instagram DM for quick questions or to follow our daily activities.' 
                : '日々の活動の様子や速報の確認、SNS経由での簡単なご相談・ご質問はこちらからお気軽にどうぞ。'}
            </p>
          </div>
          <a href="https://instagram.com/2024nsfproject" target="_blank" rel="noopener noreferrer" class="text-orange-600 font-black text-sm hover:underline pt-2 break-all">
            @2024nsfproject
          </a>
        </div>

      </div>

      <!-- ▼ 詳細パネル（主要対応項目・注意事項・プライバシーポリシー） -->
      <div class="space-y-8 max-w-4xl mx-auto w-full box-border">
        
        <!-- 主要対応項目 -->
        <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-6 md:p-8 border border-slate-200/80 shadow-[0_10px_30px_rgba(0,0,0,0.03)] w-full box-border">
          <h3 class="font-black text-slate-900 text-center mb-6 border-b border-slate-100 pb-4 text-base md:text-lg flex items-center justify-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
            {currentLang === 'en' ? 'Main Inquiry Types' : '主に対応している項目'}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 px-1 md:px-2 w-full">
            
            <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-100 flex items-start space-x-3">
              <span class="text-blue-600 font-bold text-lg shrink-0 leading-none">●</span>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed break-words font-medium">
                <span class="font-black text-slate-900 block text-sm mb-0.5">
                  {currentLang === 'en' ? 'Document Requests' : '資料のご請求'}
                </span>
                {currentLang === 'en' ? 'Activity reports, pamphlets, etc.' : '活動実績や団体パンフレット等の送付'}
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-100 flex items-start space-x-3">
              <span class="text-blue-600 font-bold text-lg shrink-0 leading-none">●</span>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed break-words font-medium">
                <span class="font-black text-slate-900 block text-sm mb-0.5">
                  {currentLang === 'en' ? 'Media & Interview Requests' : '取材依頼・メディア掲載'}
                </span>
                {currentLang === 'en' ? 'Interviews for newspapers, TV, web media' : '新聞、テレビ、WEB媒体等のインタビュー等'}
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-100 flex items-start space-x-3">
              <span class="text-blue-600 font-bold text-lg shrink-0 leading-none">●</span>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed break-words font-medium">
                <span class="font-black text-slate-900 block text-sm mb-0.5">
                  {currentLang === 'en' ? 'Feedback & Opinions' : 'ご意見・ご感想'}
                </span>
                {currentLang === 'en' ? 'Feedback or support regarding our daily activities' : '日々の活動に対するフィードバックや応援'}
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-100 flex items-start space-x-3">
              <span class="text-blue-600 font-bold text-lg shrink-0 leading-none">●</span>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed break-words font-medium">
                <span class="font-black text-slate-900 block text-sm mb-0.5">
                  {currentLang === 'en' ? 'Partnerships & Proposals' : '共同連携・イベントのご提案'}
                </span>
                {currentLang === 'en' ? 'Proposals from companies, organizations, schools' : '企業・他団体様、学校関係者様からのご相談'}
              </p>
            </div>

          </div>
        </div>

        <!-- 注意事項 ＆ プライバシーポリシー -->
        <div class="bg-white/90 backdrop-blur-xl border border-slate-200/80 rounded-3xl p-6 md:p-8 space-y-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)] w-full box-border">
          
          <div class="space-y-3 w-full">
            <h3 class="font-black text-slate-900 text-base border-b border-slate-100 pb-3 flex items-center break-words">
              <span class="w-2.5 h-6 bg-gradient-to-b from-blue-600 to-indigo-600 rounded-full mr-3 shrink-0 shadow-xs"></span>
              {currentLang === 'en' ? 'Important Notes' : 'フォームご利用にあたって'}
            </h3>
            <ul class="text-xs md:text-sm text-slate-600 space-y-2.5 leading-relaxed list-disc pl-5 break-words font-medium">
              {currentLang === 'en' ? (
                <>
                  <li>An <strong class="text-slate-900">automated confirmation email</strong> will be sent to your email address upon submission.</li>
                  <li>If you do not receive the automated response, please check for input errors or inspect your spam folder.</li>
                  <li>We typically respond to inquiries within <strong class="text-slate-900">2 to 3 business days</strong>.</li>
                </>
              ) : (
                <>
                  <li>送信完了後、ご入力いただいたメールアドレス宛に<strong class="text-slate-900">受付確認の自動返信メール</strong>が届きます。</li>
                  <li>万が一自動返信メールが届かない場合は、メールアドレスの入力誤りや、迷惑メールフォルダをご確認ください。</li>
                  <li>お問い合わせにつきましては、通常 <strong class="text-slate-900">2〜3営業日以内</strong> に担当者よりご連絡をさせていただきます。</li>
                </>
              )}
            </ul>
          </div>

          <!-- プライバシーポリシー (アコーディオン) -->
          <details class="group border border-slate-200/80 rounded-2xl overflow-hidden transition-all duration-300 w-full box-border shadow-xs">
            <summary class="flex items-center justify-between p-4 bg-slate-50/80 hover:bg-slate-100/80 font-black text-slate-900 text-xs md:text-sm cursor-pointer list-none select-none transition">
              <div class="flex items-center min-w-0 pr-2">
                <span class="w-2 h-4 bg-blue-600 rounded-xs mr-2.5 shrink-0"></span>
                <span class="break-words">{currentLang === 'en' ? 'Check Privacy Policy' : '個人情報の取扱い（プライバシーポリシー）を確認する'}</span>
              </div>
              <svg class="w-4 h-4 text-slate-500 shrink-0 transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            
            <div class="p-4 md:p-6 border-t border-slate-200/80 space-y-4 bg-white w-full box-border">
              <p class="text-xs text-slate-600 leading-relaxed font-medium break-words">
                {currentLang === 'en'
                  ? 'NSF PROJECTs recognizes the importance of personal information provided through inquiries, complies with laws regarding the protection of personal information, and strives for proper management under the following policy.'
                  : 'NSF PROJECTsは、お問い合わせいただいた皆様の個人情報の重要性を認識し、個人情報の保護に関する法律を遵守するとともに、以下のポリシーに従って適切な管理に努めます。'}
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs w-full">
                <div class="space-y-1 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <h4 class="font-black text-blue-600 break-words">
                    {currentLang === 'en' ? '1. Purpose of Use' : '1. 利用目的'}
                  </h4>
                  <p class="text-slate-600 leading-relaxed font-medium break-words">
                    {currentLang === 'en' 
                      ? 'Personal info (name, email, etc.) is used solely for responding to inquiries, contacting you, and analyzing for activity improvement.' 
                      : '取得した氏名やメールアドレス等の個人情報は、お問い合わせへの回答・連絡、および活動改善のための分析にのみ利用いたします。'}
                  </p>
                </div>
                <div class="space-y-1 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <h4 class="font-black text-blue-600 break-words">
                    {currentLang === 'en' ? '2. Prohibition of Third-Party Disclosure' : '2. 第三者提供の禁止'}
                  </h4>
                  <p class="text-slate-600 leading-relaxed font-medium break-words">
                    {currentLang === 'en' 
                      ? 'We will not disclose or provide personal information to third parties without consent, except when required by law.' 
                      : '法令に基づく場合を除き、利用者の同意を得ることなく、取得した個人情報を第三者に提供または開示することはありません。'}
                  </p>
                </div>
                <div class="space-y-1 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <h4 class="font-black text-blue-600 break-words">
                    {currentLang === 'en' ? '3. Safety Management Measures' : '3. 安全管理措置'}
                  </h4>
                  <p class="text-slate-600 leading-relaxed font-medium break-words">
                    {currentLang === 'en' 
                      ? 'We implement appropriate security measures to prevent unauthorized access, loss, alteration, or leakage of personal data.' 
                      : 'お預かりした個人情報への不正アクセス、紛失、改ざん、および漏洩を防止するため、適切な安全管理措置を講じます。'}
                  </p>
                </div>
                <div class="space-y-1 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                  <h4 class="font-black text-blue-600 break-words">
                    {currentLang === 'en' ? '4. Contact Window' : '4. お問い合わせ窓口'}
                  </h4>
                  <p class="text-slate-600 leading-relaxed font-medium break-words">
                    {currentLang === 'en' 
                      ? 'We promptly respond to requests for disclosure, correction, or deletion of personal info. Contact: jyrac.pr@gmail.com' 
                      : 'ご本人からの個人情報の開示・訂正・削除のご請求には速やかに対応いたします。窓口（jyrac.pr@gmail.com）までご連絡ください。'}
                  </p>
                </div>
              </div>
            </div>
          </details>

          <p class="text-center text-xs text-slate-400 font-bold pt-2 break-words">
            {currentLang === 'en' 
              ? '* Please agree to the guidelines, notes, and privacy policy above before contacting us through any of the channels below.' 
              : '※上記の対応項目、注意事項、および個人情報の取扱いに同意の上、以下のいずれかの窓口よりお問い合わせください。'}
          </p>
        </div>

      </div>

    </div>
  </div>
</Layout>

<style>
  /* Safari等のデフォルト矢印表示を制御 */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
