---
// src/pages/ema.astro
// オーロラグラデーション＆Glassmorphism強化版 応援絵馬掲示板ページ

import Layout from '../layouts/Layout.astro';
import EmaBoard from '../components/EmaBoard.astro';
import { translations, type Lang } from '../lib/i18n';

// URLから現在の言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout 
  title={currentLang === 'en' ? "Support Ema Board | NSF PROJECTs" : "応援絵馬掲示板 | NSF PROJECTs"} 
  activeKey="ema"
>
  <!-- 背景オーロラグロー＆強力グラデーション -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-slate-50 via-blue-50/40 to-indigo-50/30 py-12 md:py-16">
    <!-- 光彩アクセント1 (左上) -->
    <div class="absolute -top-32 -left-20 w-[600px] h-[600px] bg-gradient-to-br from-blue-500/25 via-cyan-400/20 to-transparent rounded-full blur-[150px] pointer-events-none"></div>
    <!-- 光彩アクセント2 (中央右) -->
    <div class="absolute top-1/3 -right-24 w-[650px] h-[650px] bg-gradient-to-bl from-indigo-500/20 via-purple-300/15 to-transparent rounded-full blur-[160px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">
      
      <!-- ページヘッダー（Glassmorphism） -->
      <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-8 sm:p-12 border border-white/90 shadow-[0_15px_35px_rgba(0,0,0,0.03)] text-center max-w-4xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-blue-500/10 to-indigo-500/10 border border-blue-300/40 text-blue-600 text-xs font-black tracking-widest uppercase backdrop-blur-md shadow-xs">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>SUPPORT EMA BOARD</span>
        </div>

        <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-900">
            {currentLang === 'en' ? 'Support Ema Board' : '応援絵馬掲示板'}
          </span>
        </h1>

        <div class="w-16 h-1.5 bg-gradient-to-r from-blue-600 via-indigo-500 to-purple-500 mx-auto rounded-full shadow-xs"></div>

        <p class="text-slate-600 text-sm sm:text-base font-semibold max-w-2xl mx-auto leading-relaxed break-words pt-1">
          {currentLang === 'en' 
            ? 'Messages collected from all over Japan will be turned into "Ema" and delivered to the affected area.' 
            : '全国から寄せられたメッセージを「絵馬」にして現地へ届けます。'}
        </p>
      </div>

      <!-- メインコンテンツ（絵馬ボードコンポーネント） -->
      <div class="relative z-10">
        <EmaBoard />
      </div>

      <!-- ボトムCTA導線 -->
      <section class="bg-white/80 backdrop-blur-xl rounded-3xl border border-white/90 p-8 sm:p-12 shadow-[0_15px_35px_rgba(0,0,0,0.03)] text-center max-w-3xl mx-auto space-y-6">
        <div class="space-y-2">
          <h3 class="text-xl sm:text-2xl font-black text-slate-900 break-words">
            {currentLang === 'en' ? 'About NSF PROJECTs Initiatives' : 'NSF PROJECTs の取り組みについて'}
          </h3>
          <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed break-words">
            {currentLang === 'en' 
              ? 'Discover the latest initiatives by student members nationwide regarding regional revitalization and disaster prevention/mitigation on our official Note and project pages.' 
              : '地域創生や防災・減災に関する全国の学生メンバーによる最新の活動は、公式Noteや各プロジェクトページからご覧いただけます。'}
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-4 w-full pt-2">
          <a 
            href="/projects" 
            class="inline-flex items-center justify-center bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white text-xs sm:text-sm font-black px-7 py-3.5 rounded-xl shadow-md shadow-blue-500/20 transition-all duration-300 hover:scale-105 active:scale-95 border border-white/20 break-words"
          >
            {t.projects}
          </a>
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center bg-white hover:bg-slate-50 text-slate-800 border border-slate-200/80 text-xs sm:text-sm font-black px-7 py-3.5 rounded-xl transition-all duration-300 shadow-xs hover:border-slate-300 hover:scale-105 active:scale-95 break-words"
          >
            {currentLang === 'en' ? 'Contact Us' : 'お問い合わせ'}
          </a>
        </div>
      </section>

    </div>
  </section>
</Layout>
