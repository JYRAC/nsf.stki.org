---
// src/layouts/Layout.astro
import "../global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { translations, type Lang } from "../lib/i18n";

export type NavKey = 'home' | 'about' | 'apply' | 'materials' | 'projects' | 'contact';

interface Props {
  title: string;
  activeKey?: NavKey;
  showSplash?: boolean;
}

const { title, activeKey, showSplash = false } = Astro.props;

const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

const projectItems = [
  { label: currentLang === 'en' ? 'All Projects' : 'すべてのプロジェクト', href: '/projects' },
  { label: currentLang === 'en' ? 'Support Ema Board' : '応援絵馬掲示板', href: '/ema' },
  { label: currentLang === 'en' ? 'Mamoneru Project' : 'mamoneruプロジェクト', href: '/mamoneru' },
  { label: currentLang === 'en' ? 'Mamomizu Project' : 'まもみずプロジェクト', href: '/mamomizu' },
  { label: 'NSF Bifröst', href: '/bifrost' },
  { label: currentLang === 'en' ? 'Endless Reconstruction Project' : '果てなき復興プロジェクト', href: '/hatenaki' },
  { label: currentLang === 'en' ? 'Survival Academy' : 'survival academy', href: '/survival' },
  { label: currentLang === 'en' ? 'Noto Umaimon Rediscovery Project' : '能登うまいもん再発見プロジェクト', href: '/umaimon' },
  { label: currentLang === 'en' ? 'Kumamoto Umakamon Project' : '熊本うまかもんプロジェクト', href: '/kumamotoumakamon' },
];

const navItems = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'about', label: 'ABOUT', href: '/about' },
  { key: 'apply', label: 'APPLY', href: '/apply' },
  { key: 'materials', label: 'MATERIALS', href: '/materials' },
  { key: 'projects', label: 'PROJECTS', href: '/projects', hasSubmenu: true },
  { key: 'contact', label: 'CONTACT', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | NSF PROJECTs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body class="min-h-screen w-full max-w-full overflow-x-hidden flex flex-col antialiased text-[#081426] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-sky-50 via-slate-50 to-blue-50/30 relative">

  <!-- 全体背景：アンビエント光＆クリスタル浮遊オブジェクト -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <!-- オーラ背景グラデーション -->
    <div class="absolute -top-[20vw] -left-[10vw] w-[50vw] h-[50vw] rounded-full bg-gradient-to-br from-cyan-300/20 to-blue-500/10 blur-[100px] animate-[pulse_10s_ease-in-out_infinite]"></div>
    <div class="absolute top-[40%] -right-[15vw] w-[60vw] h-[60vw] rounded-full bg-gradient-to-tr from-blue-400/15 to-indigo-300/10 blur-[120px] animate-[pulse_12s_ease-in-out_infinite_2s]"></div>

    <!-- 浮遊クリスタルポリゴン 1 (左上) -->
    <div class="crystal-shard crystal-1"></div>
    <!-- 浮遊クリスタルポリゴン 2 (右上) -->
    <div class="crystal-shard crystal-2"></div>
    <!-- 浮遊クリスタルポリゴン 3 (中央右) -->
    <div class="crystal-shard crystal-3"></div>
  </div>

  <!-- ガラスモルフィズム・スモーキーヘッダー -->
  <header class="sticky top-0 z-50 w-full max-w-full box-border bg-white/75 backdrop-blur-md border-b border-white/60 shadow-[0_4px_20px_-10px_rgba(8,20,38,0.05)] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between w-full box-border">
      
      <!-- ロゴ -->
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <div class="p-1 rounded-xl bg-gradient-to-br from-blue-50 to-cyan-50 border border-blue-100 group-hover:scale-105 transition-transform duration-300">
          <img src="/logo.jpg" alt="NSF ロゴ" class="h-7 w-auto rounded-lg" />
        </div>
        <span class="font-black text-[#081426] text-base sm:text-lg tracking-tight group-hover:text-[#1769ff] transition-colors">NSF PROJECTs</span>
      </a>

      <!-- デスクトップナビゲーション -->
      <div class="hidden md:flex items-center gap-6">
        <nav class="flex items-center gap-2">
          {navItems.map((item) => (
            item.hasSubmenu ? (
              <div class="relative group py-4">
                <a 
                  href={item.href} 
                  class:list={[
                    "px-3.5 py-2 rounded-xl text-sm font-extrabold transition-all duration-200 flex items-center gap-1.5",
                    activeKey === item.key 
                      ? "text-[#1769ff] bg-blue-50/80 shadow-sm border border-blue-200/50" 
                      : "text-slate-700 hover:text-[#1769ff] hover:bg-slate-100/50"
                  ]}
                >
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180 text-slate-400 group-hover:text-[#1769ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                </a>
                
                <!-- ドロップダウンメニュー（クリスタルガラス感） -->
                <div class="absolute left-0 top-full hidden group-hover:block w-max min-w-[240px] max-w-xs bg-white/90 backdrop-blur-xl border border-white/80 rounded-2xl shadow-[0_10px_30px_-5px_rgba(23,105,255,0.15)] p-2 z-50 animate-[fadeIn_0.2s_ease-out]">
                  {projectItems.map((sub) => (
                    <a href={sub.href} class="block px-3.5 py-2.5 text-xs font-bold text-slate-700 hover:bg-[#1769ff] hover:text-white transition-all duration-150 rounded-xl whitespace-nowrap overflow-hidden text-ellipsis">
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a 
                href={item.href} 
                class:list={[
                  "px-3.5 py-2 rounded-xl text-sm font-extrabold transition-all duration-200",
                  activeKey === item.key 
                    ? "text-[#1769ff] bg-blue-50/80 shadow-sm border border-blue-200/50" 
                    : "text-slate-700 hover:text-[#1769ff] hover:bg-slate-100/50"
                ]}
              >
                {item.label}
              </a>
            )
          ))}
        </nav>
        
        <div class="h-4 w-[1px] bg-slate-200/80"></div>
        <LanguageSwitcher />
      </div>

      <!-- モバイル用コントロール -->
      <div class="flex items-center gap-2 md:hidden shrink-0">
        <LanguageSwitcher />
        <button id="menu-btn" class="p-2 rounded-xl bg-slate-100/80 text-slate-800 hover:bg-slate-200/80 focus:outline-none transition-colors" aria-label="メニューを開く">
          <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- モバイル用ドロワーメニュー -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100/80 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 shadow-2xl w-full box-border">
      <nav class="flex flex-col gap-1.5">
        {navItems.map((item) => (
          item.hasSubmenu ? (
            <div class="flex flex-col">
              <a href={item.href} class:list={["px-3 py-2.5 rounded-xl text-sm font-extrabold transition-colors flex justify-between items-center", activeKey === item.key ? "bg-blue-50 text-[#1769ff]" : "text-slate-800 hover:bg-slate-50"]}>
                {item.label}
              </a>
              <div class="pl-4 flex flex-col gap-1 my-1 border-l-2 border-blue-100 ml-3">
                {projectItems.map((sub) => (
                  <a href={sub.href} class="py-2 px-3 text-xs font-bold text-slate-600 hover:text-[#1769ff] hover:bg-blue-50/50 rounded-lg transition-colors">
                    ・ {sub.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={["px-3 py-2.5 rounded-xl text-sm font-extrabold transition-colors", activeKey === item.key ? "bg-blue-50 text-[#1769ff]" : "text-slate-800 hover:bg-slate-50"]}>
              {item.label}
            </a>
          )
        ))}
      </nav>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="flex-grow w-full max-w-full box-border relative z-10">
    <slot />
  </main>

  <!-- フッター -->
  <footer class="bg-[#081426] text-white py-12 mt-auto border-t border-white/10 relative z-10 overflow-hidden">
    <!-- フッター背景のほのかな光 -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-24 bg-gradient-to-b from-[#1769ff]/10 to-transparent blur-2xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3 relative z-10">
      <div class="flex items-center justify-center gap-2">
        <span class="text-xs font-black tracking-widest text-[#24d5e8] uppercase">Noto Student Fund PROJECTs</span>
      </div>
      <p class="text-xs text-slate-400 font-medium">© NSF PROJECTs. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      if (mobileMenu?.classList.contains('hidden')) {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>';
      } else {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>';
      }
    });

    document.addEventListener("DOMContentLoaded", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const lang = urlParams.get("lang");
      if (!lang) return;

      document.querySelectorAll("a").forEach((a) => {
        const href = a.getAttribute("href");
        if (href && href.startsWith("/") && !href.includes("lang=")) {
          const separator = href.includes("?") ? "&" : "?";
          a.setAttribute("href", `${href}${separator}lang=${lang}`);
        }
      });
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }
  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }
  body { 
    font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "メイリオ", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* --- クリスタル浮遊アニメーション CSS --- */
  .crystal-shard {
    position: absolute;
    border: 1px solid rgba(23, 105, 255, 0.2);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.6) 0%, rgba(36, 213, 232, 0.15) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    clip-path: polygon(50% 0%, 100% 25%, 85% 100%, 15% 90%, 0% 35%);
    pointer-events: none;
    box-shadow: 0 8px 32px 0 rgba(23, 105, 255, 0.1);
  }

  .crystal-1 {
    width: 120px;
    height: 120px;
    top: 15%;
    left: 4%;
    animation: crystalFloat1 12s ease-in-out infinite;
  }

  .crystal-2 {
    width: 180px;
    height: 180px;
    top: 30%;
    right: 5%;
    animation: crystalFloat2 15s ease-in-out infinite;
    animation-delay: -4s;
  }

  .crystal-3 {
    width: 90px;
    height: 90px;
    top: 65%;
    left: 8%;
    animation: crystalFloat1 10s ease-in-out infinite;
    animation-delay: -2s;
  }

  /* クリスタルゆらぎアニメーション Keyframes */
  @keyframes crystalFloat1 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg) scale(1);
    }
    50% {
      transform: translateY(-25px) rotate(12deg) scale(1.05);
    }
  }

  @keyframes crystalFloat2 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg) scale(1);
    }
    50% {
      transform: translateY(30px) rotate(-15deg) scale(0.95);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
