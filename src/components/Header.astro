---
// src/components/Header.astro
// 最新のトップページUI（ガラスモフィズム・洗練されたグラデーション）に合わせたヘッダー

export type NavKey = "home" | "about" | "apply" | "contact" | "projects";

interface ProjectLink {
  href: string;
  label: string;
}

const PROJECT_LINKS: ProjectLink[] = [
  { href: "/hatenaki", label: "果てなき復興プロジェクト" },
  { href: "/mamoneru", label: "Mamoneruプロジェクト" },
  { href: "/mamomizu", label: "Mamomizuプロジェクト" },
  { href: "/umaimon", label: "能登うまいもん再発見プロジェクト" },
  { href: "/survival", label: "survival Academyプロジェクト" },
  { href: "/bifrost", label: "NSF Bifröst" },
  { href: "/kumamotoumakamon", label: "熊本うまかもんプロジェクト" },
];

interface Props {
  activeKey?: NavKey;
}

const { activeKey } = Astro.props;

// ナビゲーションのリンクスタイル（アクティブ時は背景を青系のピル表示に）
const navClass = (key: NavKey) =>
  `px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-all duration-300 ${
    activeKey === key
      ? "bg-blue-50 text-blue-600 shadow-xs"
      : "text-slate-700 hover:text-blue-600 hover:bg-slate-50"
  }`;

const dropdownButtonClass = `px-3.5 py-2 rounded-xl text-xs sm:text-sm font-black transition-all duration-300 flex items-center space-x-1.5 cursor-pointer whitespace-nowrap ${
  activeKey === "projects"
    ? "bg-blue-50 text-blue-600 shadow-xs"
    : "text-slate-700 hover:text-blue-600 hover:bg-slate-50"
}`;
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200/80 shadow-[0_4px_20px_rgba(0,0,0,0.03)] h-20 transition-all">
  <div class="max-w-6xl mx-auto px-4 h-full flex items-center justify-between relative">
    
    <!-- ロゴ部分 -->
    <a href="/" class="flex items-center space-x-2 sm:space-x-3 z-50 min-w-0 group">
      <div class="p-1 rounded-xl bg-white border border-slate-200/60 shadow-xs transition-transform group-hover:scale-105 duration-300">
        <img src="/logo.jpg" alt="NSF ロゴ" class="h-9 sm:h-11 w-auto object-contain flex-shrink-0 rounded-lg">
      </div>
      <span class="font-black text-base sm:text-lg tracking-wider text-slate-900 uppercase truncate whitespace-nowrap bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-blue-900 to-slate-800">
        NSF PROJECTs
      </span>
    </a>

    <!-- PCデスクトップナビゲーション -->
    <nav class="hidden lg:flex space-x-2 font-bold text-slate-600 flex-shrink-0 items-center">
      <a href="/" class={navClass("home")}>HOME</a>
      <a href="/about" class={navClass("about")}>ABOUT</a>
      <a href="/apply" class={navClass("apply")}>APPLY</a>
      <a href="/contact" class={navClass("contact")}>CONTACT</a>

      <!-- ドロップダウンメニュー -->
      <div class="relative dropdown font-black py-2">
        <button class={dropdownButtonClass} aria-label="プロジェクト一覧を開く">
          <span>PROJECTs</span>
          <svg class="w-4 h-4 transition-transform duration-300 dropdown-icon text-slate-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div class="absolute left-0 top-full pt-2 w-72 dropdown-menu animate-in fade-in slide-in-from-top-2 duration-300">
          <div class="bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.12)] p-2 space-y-1">
            <div class="px-3 py-1.5 text-[10px] font-black tracking-widest text-blue-600 uppercase">
              PROJECT LIST
            </div>
            {PROJECT_LINKS.map((p) => (
              <a 
                href={p.href} 
                class="block px-3.5 py-2.5 rounded-xl text-xs font-bold text-slate-700 hover:bg-blue-50/80 hover:text-blue-600 transition duration-200"
              >
                {p.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- 右側アクションボタン -->
    <div class="flex items-center space-x-2 sm:space-x-3 flex-shrink-0 z-50">
      <a 
        href="/apply" 
        class="hidden sm:inline-flex items-center justify-center bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-600 text-white font-black text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-[0_4px_14px_rgba(37,99,235,0.3)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.4)] border border-white/20 transition-all duration-300 whitespace-nowrap -translate-y-0 hover:-translate-y-0.5"
      >
        メンバー加入
      </a>
      
      <!-- モバイルハンバーガーボタン -->
      <button 
        id="menu-btn" 
        class="lg:hidden p-2.5 rounded-2xl bg-slate-100/80 hover:bg-slate-200/80 text-slate-700 hover:text-blue-600 transition cursor-pointer flex-shrink-0 border border-slate-200/60" 
        aria-label="メニューを開く"
      >
        <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- モバイルメニュー（カードフロートデザイン） -->
    <div 
      id="mobile-menu" 
      class="hidden absolute top-20 left-4 right-4 bg-white/95 backdrop-blur-2xl border border-slate-200/90 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.15)] lg:hidden flex flex-col p-6 space-y-3 font-black z-40 max-h-[calc(100vh-6rem)] overflow-y-auto animate-in fade-in slide-in-from-top-4 duration-300"
    >
      <a href="/" class="text-slate-800 hover:text-blue-600 hover:bg-blue-50/60 px-4 py-2.5 rounded-xl transition text-sm block">HOME</a>
      <a href="/about" class="text-slate-800 hover:text-blue-600 hover:bg-blue-50/60 px-4 py-2.5 rounded-xl transition text-sm block">ABOUT</a>
      <a href="/apply" class="text-slate-800 hover:text-blue-600 hover:bg-blue-50/60 px-4 py-2.5 rounded-xl transition text-sm block">APPLY</a>
      <a href="/contact" class="text-slate-800 hover:text-blue-600 hover:bg-blue-50/60 px-4 py-2.5 rounded-xl transition text-sm block">CONTACT</a>
      
      <div class="border-t border-slate-200/80 pt-4 mt-1">
        <p class="text-[11px] text-blue-600 font-black uppercase tracking-widest px-4 mb-2">プロジェクト一覧</p>
        <div class="flex flex-col space-y-1">
          {PROJECT_LINKS.map((p) => (
            <a 
              href={p.href} 
              class="text-slate-700 hover:text-blue-600 hover:bg-slate-100/70 font-bold text-xs px-4 py-2 rounded-xl block transition"
            >
              ・{p.label}
            </a>
          ))}
        </div>
      </div>
      
      <a 
        href="/apply" 
        class="sm:hidden block text-center bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-black text-sm py-3.5 rounded-2xl shadow-[0_4px_14px_rgba(37,99,235,0.3)] transition mt-3"
      >
        メンバー加入
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!menuBtn || !mobileMenu) return;

    // イベントリスナーの二重登録防止
    const newBtn = menuBtn.cloneNode(true);
    menuBtn.parentNode?.replaceChild(newBtn, menuBtn);

    newBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .dropdown-menu { display: none; }
  @media (min-width: 1024px) {
    .dropdown:hover .dropdown-menu { display: block; }
    .dropdown:hover .dropdown-icon { transform: rotate(180deg); }
  }
</style>
