---
// src/components/Header.astro
// グラデーションの美しさと高い視認性（コントラスト・可読性）を両立したヘッダー

export type NavKey = "home" | "about" | "apply" | "contact" | "projects";

interface ProjectLink {
  href: string;
  label: string;
}

const PROJECT_LINKS: ProjectLink[] = [
  { href: "/hatenaki", label: "果てなき復興プロジェクト" },
  { href: "/mamoneru", label: "Mamoneruプロジェクト" },
  { href: "/mamomizu", label: "Mamomizuプロジェクト" },
  { href: "/umaimon", label: "能登うまいもん再発見プロジェクト" },
  { href: "/survival", label: "survival Academyプロジェクト" },
  { href: "/bifrost", label: "NSF Bifröst" },
  { href: "/kumamotoumakamon", label: "熊本うまかもんプロジェクト" },
];

interface Props {
  activeKey?: NavKey;
}

const { activeKey } = Astro.props;

// デスクトップナビゲーション用クラス
// アクティブ時はグラデーションピル＋白文字で視認性を向上
const navClass = (key: NavKey) =>
  `px-4 py-2 rounded-xl text-xs sm:text-sm font-black transition-all duration-300 ${
    activeKey === key
      ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/25"
      : "text-slate-700 hover:text-blue-600 hover:bg-slate-100/80"
  }`;

// モバイルナビゲーション用クラス
const mobileNavClass = (key: NavKey) =>
  `px-4 py-3 rounded-xl transition-all duration-200 text-sm block font-black ${
    activeKey === key
      ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-sm"
      : "text-slate-800 hover:text-blue-600 hover:bg-blue-50/80"
  }`;

const dropdownButtonClass = `px-4 py-2 rounded-xl text-xs sm:text-sm font-black transition-all duration-300 flex items-center space-x-1.5 cursor-pointer whitespace-nowrap ${
  activeKey === "projects"
    ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/25"
    : "text-slate-700 hover:text-blue-600 hover:bg-slate-100/80"
}`;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-slate-200/80 shadow-[0_4px_25px_rgba(15,23,42,0.06)] transition-all">
  <!-- アクセントグラデーションバー -->
  <div class="h-1 w-full bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400"></div>

  <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between relative">
    
    <!-- ロゴ部分 -->
    <a href="/" class="flex items-center space-x-2.5 sm:space-x-3.5 z-50 min-w-0 group py-1">
      <div class="p-1 rounded-xl bg-gradient-to-br from-white to-slate-100 border border-slate-200/80 shadow-xs transition-all group-hover:scale-105 group-hover:shadow-md duration-300">
        <img src="/logo.jpg" alt="NSF ロゴ" class="h-9 sm:h-10 w-auto object-contain flex-shrink-0 rounded-lg">
      </div>
      <span class="font-black text-base sm:text-lg tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-900 uppercase truncate whitespace-nowrap">
        NSF PROJECTs
      </span>
    </a>

    <!-- PCデスクトップナビゲーション -->
    <nav class="hidden lg:flex space-x-1.5 font-bold flex-shrink-0 items-center">
      <a href="/" class={navClass("home")}>HOME</a>
      <a href="/about" class={navClass("about")}>ABOUT</a>
      <a href="/apply" class={navClass("apply")}>APPLY</a>
      <a href="/contact" class={navClass("contact")}>CONTACT</a>

      <!-- ドロップダウンメニュー -->
      <div class="relative dropdown font-black py-2">
        <button class={dropdownButtonClass} aria-label="プロジェクト一覧を開く">
          <span>PROJECTs</span>
          <svg class={`w-4 h-4 transition-transform duration-300 dropdown-icon ${activeKey === "projects" ? "text-white" : "text-slate-400 group-hover:text-blue-600"}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- ドロップダウンカード（グラデーション枠線＆立体感） -->
        <div class="absolute left-0 top-full pt-1.5 w-72 dropdown-menu animate-in fade-in slide-in-from-top-2 duration-300">
          <div class="p-[1px] rounded-2xl bg-gradient-to-b from-blue-300/60 via-slate-200 to-slate-200/60 shadow-[0_16px_40px_rgba(15,23,42,0.15)]">
            <div class="bg-white/98 backdrop-blur-2xl rounded-2xl p-2 space-y-1">
              <div class="px-3 py-1.5 text-[10px] font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 uppercase">
                PROJECT LIST
              </div>
              {PROJECT_LINKS.map((p) => (
                <a 
                  href={p.href} 
                  class="block px-3.5 py-2.5 rounded-xl text-xs font-bold text-slate-800 hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50/50 hover:text-blue-600 transition duration-200"
                >
                  {p.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- 右側アクションボタン -->
    <div class="flex items-center space-x-2 sm:space-x-3 flex-shrink-0 z-50">
      <a 
        href="/apply" 
        class="hidden sm:inline-flex items-center justify-center bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-500 text-white font-black text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-[0_4px_16px_rgba(37,99,235,0.35)] hover:shadow-[0_6px_22px_rgba(37,99,235,0.5)] border border-white/20 transition-all duration-300 whitespace-nowrap active:scale-95"
      >
        メンバー加入
      </a>
      
      <!-- モバイルハンバーガーボタン -->
      <button 
        id="menu-btn" 
        class="lg:hidden p-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200/80 text-slate-800 hover:text-blue-600 transition cursor-pointer flex-shrink-0 border border-slate-200/80 shadow-xs" 
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- モバイルメニュー（カードフロート＋グラデーション枠線） -->
    <div 
      id="mobile-menu" 
      class="hidden absolute top-24 left-4 right-4 lg:hidden p-[1px] rounded-3xl bg-gradient-to-b from-blue-300/80 via-slate-200 to-slate-200/80 shadow-[0_20px_60px_rgba(15,23,42,0.2)] z-40 animate-in fade-in slide-in-from-top-4 duration-300"
    >
      <div class="bg-white/98 backdrop-blur-2xl rounded-3xl p-5 space-y-2 font-black max-h-[calc(100vh-7rem)] overflow-y-auto">
        <a href="/" class={mobileNavClass("home")}>HOME</a>
        <a href="/about" class={mobileNavClass("about")}>ABOUT</a>
        <a href="/apply" class={mobileNavClass("apply")}>APPLY</a>
        <a href="/contact" class={mobileNavClass("contact")}>CONTACT</a>
        
        <div class="border-t border-slate-200/80 pt-3.5 mt-2">
          <p class="text-[11px] text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 font-black uppercase tracking-widest px-4 mb-2">
            プロジェクト一覧
          </p>
          <div class="flex flex-col space-y-1">
            {PROJECT_LINKS.map((p) => (
              <a 
                href={p.href} 
                class="text-slate-700 hover:text-blue-600 hover:bg-gradient-to-r hover:from-blue-50/80 hover:to-indigo-50/40 font-bold text-xs px-4 py-2.5 rounded-xl block transition"
              >
                ・{p.label}
              </a>
            ))}
          </div>
        </div>
        
        <a 
          href="/apply" 
          class="sm:hidden block text-center bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 text-white font-black text-sm py-3.5 rounded-2xl shadow-md shadow-blue-500/30 transition mt-3 active:scale-98"
        >
          メンバー加入
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!menuBtn || !mobileMenu) return;

    const newBtn = menuBtn.cloneNode(true) as HTMLButtonElement;
    menuBtn.parentNode?.replaceChild(newBtn, menuBtn);

    const iconOpen = newBtn.querySelector('#icon-open');
    const iconClose = newBtn.querySelector('#icon-close');

    // 初期化（メニュー閉じる）
    mobileMenu.classList.add('hidden');
    newBtn.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');

    newBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.toggle('hidden');
      const isExpanded = !isHidden;

      newBtn.setAttribute('aria-expanded', String(isExpanded));
      iconOpen?.classList.toggle('hidden', isExpanded);
      iconClose?.classList.toggle('hidden', !isExpanded);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .dropdown-menu { display: none; }
  @media (min-width: 1024px) {
    .dropdown:hover .dropdown-menu,
    .dropdown:focus-within .dropdown-menu { 
      display: block; 
    }
    .dropdown:hover .dropdown-icon,
    .dropdown:focus-within .dropdown-icon { 
      transform: rotate(180deg); 
    }
  }
</style>
