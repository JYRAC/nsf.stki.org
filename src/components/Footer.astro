---
// src/components/Footer.astro
// トップページ・ヘッダーの最新UI（グラデーション・丸み・洗練されたカード感）に合わせたフッター

const PROJECT_LINKS = [
  { href: "/hatenaki", label: "果てなき復興プロジェクト" },
  { href: "/mamoneru", label: "Mamoneruプロジェクト" },
  { href: "/mamomizu", label: "Mamomizuプロジェクト" },
  { href: "/umaimon", label: "能登うまいもん再発見プロジェクト" },
  { href: "/survival", label: "survival Academyプロジェクト" },
  { href: "/bifrost", label: "NSF Bifröst" },
  { href: "/kumamotoumakamon", label: "熊本うまかもんプロジェクト" },
];
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800/80 pt-16 pb-12 mt-auto relative overflow-hidden">
  <!-- 背景アクセントグラデーション -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-t from-blue-600/10 via-indigo-600/5 to-transparent blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- ブランド情報 -->
      <div class="md:col-span-5 space-y-4">
        <a href="/" class="inline-flex items-center space-x-3 group">
          <div class="p-1.5 rounded-xl bg-white border border-slate-200/20 shadow-xs transition-transform group-hover:scale-105 duration-300">
            <img src="/logo.jpg" alt="NSF ロゴ" class="h-10 w-auto object-contain rounded-lg">
          </div>
          <span class="font-black text-xl tracking-wider text-white uppercase bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-slate-400">
            NSF PROJECTs
          </span>
        </a>
        <p class="text-xs text-slate-400 font-medium leading-relaxed max-w-sm">
          能登半島地震の復興支援を原点に、全国500名超の学生が集結。「若者が声をあげ、行動し、未来を創る」を理念に様々な社会課題に挑戦する学生団体です。
        </p>
        <div class="pt-2">
          <a 
            href="/apply" 
            class="inline-flex items-center gap-2 text-xs font-black px-4 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white transition shadow-md"
          >
            <span>メンバー加入に応募する</span>
            <span>➔</span>
          </a>
        </div>
      </div>

      <!-- メインナビゲーション -->
      <div class="md:col-span-3 space-y-3">
        <p class="text-xs font-black text-blue-400 uppercase tracking-widest">Navigation</p>
        <ul class="space-y-2 text-xs font-bold">
          <li><a href="/" class="hover:text-white transition">HOME</a></li>
          <li><a href="/about" class="hover:text-white transition">ABOUT</a></li>
          <li><a href="/apply" class="hover:text-white transition">APPLY（メンバー募集）</a></li>
          <li><a href="/contact" class="hover:text-white transition">CONTACT（お問い合わせ）</a></li>
          <li><a href="/ema" class="hover:text-white transition">応援絵馬を投稿する</a></li>
        </ul>
      </div>

      <!-- プロジェクト一覧 -->
      <div class="md:col-span-4 space-y-3">
        <p class="text-xs font-black text-blue-400 uppercase tracking-widest">Projects</p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-2 text-xs font-medium">
          {PROJECT_LINKS.map((p) => (
            <li>
              <a href={p.href} class="hover:text-white transition flex items-center gap-1.5">
                <span class="text-blue-500 text-[10px]">●</span>
                <span>{p.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- 著作権 & 下部フッター -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-500">
      <p class="tracking-widest uppercase">
        &copy; 2026 NSF PROJECTs. All Rights Reserved.
      </p>
      <div class="flex items-center space-x-6">
        <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition">
          Instagram
        </a>
        <a href="https://note.com" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition">
          Note
        </a>
      </div>
    </div>
  </div>
</footer>
